---
// One list of articles with the pillar filter bar on top. Used by /blog/ (All) and the
// five pillar pages (/learn/{id}/). Each filter is a real link to its own page, so every
// pillar is indexable and shareable; there is no pagination.
import PostCard from './PostCard.astro';
import { AREAS } from '../lib/learn.js';
import { allPosts, inTerritory } from '../lib/posts.js';
const { title, intro, posts, active = 'all', eyebrow } = Astro.props;
const filters = [
  { id: 'all', label: 'All', href: '/blog/', count: allPosts.length },
  ...AREAS.map((a) => ({ id: a.id, label: a.label, href: `/learn/${a.id}/`, count: inTerritory(a.id).length })),
];
---
<section class="wrap">
  <header class="top">
    <div class="rule"></div>
    {eyebrow && <div class="eyebrow blue">{eyebrow}</div>}
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
  </header>
  <nav class="filters" aria-label="Filter articles by topic">
    {filters.map((f) => (
      <a class="f" href={f.href} aria-current={f.id === active ? 'page' : undefined}>{f.label} <span class="n">{f.count}</span></a>
    ))}
  </nav>
  <div class="grid">
    {posts.map((p) => <PostCard post={p} headingLevel="h2" />)}
  </div>
</section>

<style>
  .top { padding: 32px 0 24px; display: flex; flex-direction: column; gap: 12px; max-width: 760px; }
  h1 { font-size: clamp(34px, 5vw, 52px); font-weight: 800; letter-spacing: -0.025em; }
  .top p { margin: 0; font-size: 20px; line-height: 1.5; color: var(--ink-3); }
  .filters { display: flex; flex-wrap: wrap; gap: 10px; padding: 0 0 32px; margin-bottom: 32px; border-bottom: 1px solid var(--line); }
  .f { display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 16px; border: 1px solid var(--line-2); border-radius: 999px; font-size: 15px; font-weight: 700; color: var(--ink-2); text-decoration: none; background: var(--surface); }
  .f:hover { border-color: var(--blue); color: var(--blue); }
  .f .n { font-size: 13px; font-weight: 700; color: var(--muted-2); }
  .f[aria-current='page'] { background: var(--blue); border-color: var(--blue); color: #fff; }
  .f[aria-current='page'] .n { color: rgba(255,255,255,.75); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 40px 28px; }
  @media (max-width: 980px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
    .filters { gap: 8px; padding-bottom: 24px; margin-bottom: 24px; }
    .f { height: 38px; padding: 0 13px; font-size: 14px; }
  }
</style>
