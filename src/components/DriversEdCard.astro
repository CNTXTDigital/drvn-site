---
// Partner block for online driver's ed. Pass `state` to use that state's offer; otherwise the general Aceable link.
import { driversEdLink } from '../site.js';
const { state } = Astro.props;
const offer = driversEdLink(state);
const isAceable = offer.provider === 'Aceable';
---
<aside class="edcard" aria-label="Online driver's ed partner">
  <div class="brand">
    {isAceable
      ? <span class="wordmark aceable">Aceable</span>
      : <span class="wordmark">{offer.provider}</span>}
    <span class="tag">Partner</span>
  </div>
  <p class="h">State-Approved Online Driving Courses</p>
  <p class="s">{offer.provider} offers state-certified online driving courses designed to make learning safe driving skills engaging and effective.</p>
  <a class="btn btn-sm" href={offer.url} rel="sponsored noopener" target="_blank">Visit {offer.provider}</a>
  <p class="fine">DRVN may earn a commission when you enroll through this link.</p>
</aside>

<style>
  .edcard { border: 1px solid var(--line-2); border-radius: 16px; padding: 24px; background: var(--surface); display: flex; flex-direction: column; gap: 10px; }
  .brand { display: flex; align-items: center; justify-content: space-between; }
  .wordmark { font-size: 22px; font-weight: 800; letter-spacing: -0.02em; color: var(--ink); }
  .tag { font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted-2); }
  .h { margin: 4px 0 0; font-size: 19px; font-weight: 700; color: var(--blue); line-height: 1.25; }
  .s { margin: 0 0 6px; font-size: 15px; line-height: 1.55; color: var(--ink-3); }
  .btn { align-self: flex-start; }
  .fine { margin: 4px 0 0; font-size: 12px; color: var(--muted); }
</style>
