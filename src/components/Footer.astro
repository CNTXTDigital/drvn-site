---
import { SITE } from '../site.js';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <img src="/drvn-logo.svg" alt="DRVN" width="92" height="32" class="flogo" />
      <p class="tag">{SITE.tagline}</p>
    </div>
    <nav aria-label="Footer">
      <a href="/learn/">Learn</a>
      <a href="/guide/">State Guides</a>
      <a href="/app/">DRVN App</a>
      <a href="/about/">About</a>
    </nav>
    <nav aria-label="Standards and legal">
      <a href="/editorial-standards/">Editorial Standards</a>
      <a href="/evidence/">Evidence Library</a>
      <a href="/privacy-policy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
      <a href="/contact/">Contact</a>
    </nav>
  </div>
  <div class="wrap legal">
    <div class="social">
      <a href={SITE.social.facebook} rel="noopener">Facebook</a><span aria-hidden="true">·</span>
      <a href={SITE.social.instagram} rel="noopener">Instagram</a><span aria-hidden="true">·</span>
      <a href={SITE.social.twitter} rel="noopener">X / Twitter</a>
    </div>
    <p class="disclaimer">DRVN provides educational information and tools to support supervised driver practice. It is not a substitute for professional driver instruction, official state licensing requirements, or the judgment of a qualified supervising driver. Licensing laws and requirements change. Always verify current requirements with your state's licensing agency.</p>
    <span>© {year} DRVN, LLC. All rights reserved.</span>
  </div>
</footer>

<style>
  .site-footer { background: #0E2433; color: #B9C7D0; margin-top: 56px; padding: 40px 0 24px; font-size: 15px; }
  .grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 40px; }
  .flogo { height: 30px; width: auto; filter: brightness(0) invert(1); opacity: .92; }
  .tag { margin: 14px 0 0; max-width: 22em; }
  nav { display: flex; flex-direction: column; gap: 10px; }
  .social { display: flex; flex-wrap: wrap; gap: 6px 10px; font-size: 14px; margin-bottom: 4px; }
  .social a { color: #C9D6DE; }
  a { color: #E6EEF3; text-decoration: none; }
  a:hover { color: var(--cyan-light); }
  .legal { display: flex; flex-direction: column; gap: 4px; margin-top: 28px; padding-top: 18px; border-top: 1px solid #23394A; font-size: 13px; color: #7F93A1; }
  .disclaimer { margin: 6px 0 4px; max-width: 62em; line-height: 1.5; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; gap: 28px; } }
</style>
