---
// A list of nearby driving schools / exam locations on a guide page.
import { formatPhone, mapsUrl } from '../lib/guide.js';
const { title, places = [] } = Astro.props;
---
{places.length > 0 && (
  <div class="places">
    <p class="ph">{title}</p>
    <ul>
      {places.map((p) => {
        const phone = formatPhone(p.phone);
        return (
          <li>
            <div class="top">
              {p.osa ? <span class="name">{p.name}</span> : <a class="name" href={p.url}>{p.name}</a>}
              {p.miles != null && <span class="mi">{p.miles} mi</span>}
            </div>
            <div class="addr">{[p.addr, p.city].filter(Boolean).join(', ')}, {p.st} {p.zip}</div>
            <div class="acts">
              {phone && <a href={phone.tel}>{phone.text}</a>}
              {p.website && <a href={p.website} rel="nofollow noopener" target="_blank">Website</a>}
              <a href={mapsUrl(p)} rel="nofollow noopener" target="_blank">Directions</a>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
)}

<style>
  .places { margin-top: 14px; border-top: 1px solid var(--line); padding-top: 12px; }
  .ph { margin: 0 0 6px; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted-2); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 22px; }
  li { padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 15px; line-height: 1.45; }
  .top { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; }
  .name { font-weight: 700; color: var(--ink); text-decoration: none; }
  a.name { color: var(--blue); }
  .mi { flex: none; font-size: 13px; color: var(--muted); }
  .addr { color: var(--ink-3); font-size: 14px; }
  .acts { display: flex; gap: 14px; flex-wrap: wrap; font-size: 14px; margin-top: 2px; }
  .acts a { font-weight: 600; }
  @media (max-width: 720px) { ul { grid-template-columns: 1fr; } }
</style>
