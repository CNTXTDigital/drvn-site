---
// Type-ahead search for state and city guides. Two modes:
//   places={[{ l: 'Aurora', u: '/guide/aurora-co/' }, ...]}  inline list (one state's cities)
//   src="/places.json"                                      full index (compact form), fetched on first focus
// Suggestions are real links, so they work as ordinary navigation (and in analytics).
const {
  id = 'place-search',
  label = 'Find your city',
  placeholder = 'Type your city',
  places = null,
  src = null,
  notFound = 'No guide for that city yet.',
} = Astro.props;
---
<div class="ps" data-place-search data-src={src || undefined} data-notfound={notFound}>
  <label for={id} class="ps-label">{label}</label>
  <div class="ps-box">
    <svg class="ps-icon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="2"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <input id={id} type="search" autocomplete="off" spellcheck="false" placeholder={placeholder}
      role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={`${id}-list`} />
  </div>
  <ul id={`${id}-list`} class="ps-list" role="listbox" hidden></ul>
  <p class="ps-none" hidden></p>
  {places && <script type="application/json" class="ps-data" set:html={JSON.stringify(places)} />}
</div>

<script>
  type Place = { l: string; u: string; s?: string };
  const norm = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/\bst\.?\s/g, 'saint ').replace(/\bft\.?\s/g, 'fort ').replace(/\bmt\.?\s/g, 'mount ')
    .replace(/[^a-z0-9 ]+/g, ' ').replace(/\s+/g, ' ').trim();

  for (const root of document.querySelectorAll<HTMLElement>('[data-place-search]')) {
    const input = root.querySelector('input')!;
    const list = root.querySelector('ul')!;
    const none = root.querySelector<HTMLElement>('.ps-none')!;
    const inline = root.querySelector('.ps-data');
    let data: (Place & { k: string })[] | null = null;
    let loading: Promise<void> | null = null;
    let active = -1;

    const prep = (arr: Place[]) => { data = arr.map((p) => ({ ...p, k: norm(p.l) })); };
    if (inline) prep(JSON.parse(inline.textContent || '[]'));
    const load = () => {
      if (data || loading || !root.dataset.src) return loading;
      loading = fetch(root.dataset.src).then((r) => r.json())
        .then((j: { n: Record<string, string>; p: [string, string, number?][] }) => prep(j.p.map(([l, slug, isState]) => ({
          l, u: `/guide/${slug}/`, s: isState ? 'State guide' : j.n[l.slice(-2)],
        }))))
        .catch(() => { data = []; });
      return loading;
    };

    const close = () => { list.hidden = true; list.innerHTML = ''; input.setAttribute('aria-expanded', 'false'); input.removeAttribute('aria-activedescendant'); active = -1; };
    const setActive = (i: number) => {
      const items = [...list.querySelectorAll('a')];
      items.forEach((a, j) => a.setAttribute('aria-selected', String(j === i)));
      active = i;
      if (items[i]) input.setAttribute('aria-activedescendant', items[i].id);
    };

    const render = async () => {
      if (!data) { await load(); }
      const q = norm(input.value);
      none.hidden = true;
      if (!q || !data) return close();
      const starts: Place[] = [], words: Place[] = [], has: Place[] = [];
      for (const p of data) {
        if (p.k.startsWith(q)) starts.push(p);
        else if (p.k.includes(' ' + q)) words.push(p);
        else if (q.length > 2 && p.k.includes(q)) has.push(p);
      }
      // Exact name first ("columbus" matches "Columbus" or "Columbus, OH"), then by list order (population).
      const exact = (p: Place & { k?: string }) => { const k = (p as any).k as string; return k === q || k.split(' ').slice(0, -1).join(' ') === q; };
      starts.sort((a, b) => Number(exact(b)) - Number(exact(a)));
      const hits = [...starts, ...words, ...has].slice(0, 8);
      if (!hits.length) {
        close();
        if (q.length > 2) { none.textContent = root.dataset.notfound || ''; none.hidden = false; }
        return;
      }
      list.innerHTML = '';
      hits.forEach((p, i) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'presentation');
        const a = document.createElement('a');
        a.href = p.u; a.id = `${input.id}-o${i}`; a.setAttribute('role', 'option'); a.tabIndex = -1;
        a.textContent = p.l;
        if (p.s) { const s = document.createElement('span'); s.textContent = p.s; a.append(s); }
        li.append(a); list.append(li);
      });
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      setActive(0);
    };

    input.addEventListener('focus', () => { load(); });
    input.addEventListener('input', render);
    input.addEventListener('keydown', (e) => {
      const items = [...list.querySelectorAll('a')];
      if (e.key === 'ArrowDown' && items.length) { e.preventDefault(); setActive((active + 1) % items.length); }
      else if (e.key === 'ArrowUp' && items.length) { e.preventDefault(); setActive((active - 1 + items.length) % items.length); }
      else if (e.key === 'Enter' && items[active]) { e.preventDefault(); items[active].click(); }
      else if (e.key === 'Escape') { close(); }
    });
    document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) close(); });
  }
</script>

<style>
  .ps { position: relative; max-width: 460px; }
  .ps-label { display: block; font-size: 15px; font-weight: 700; color: var(--ink); margin-bottom: 8px; }
  .ps-box { position: relative; }
  .ps-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
  input { width: 100%; font: inherit; font-size: 17px; padding: 13px 14px 13px 42px; border: 1px solid var(--line-2); border-radius: 10px; background: var(--surface); color: var(--ink); -webkit-appearance: none; appearance: none; }
  input:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(10,108,165,.15); }
  .ps-list { position: absolute; z-index: 30; left: 0; right: 0; top: calc(100% + 6px); margin: 0; padding: 6px; list-style: none; background: var(--surface); border: 1px solid var(--line-2); border-radius: 12px; box-shadow: 0 22px 44px -24px rgba(14,36,51,.4); }
  .ps-list :global(a) { display: flex; justify-content: space-between; gap: 12px; padding: 10px 12px; border-radius: 8px; font-size: 16px; font-weight: 600; color: var(--ink); text-decoration: none; }
  .ps-list :global(a span) { font-size: 13px; font-weight: 600; color: var(--muted); }
  .ps-list :global(a[aria-selected='true']), .ps-list :global(a:hover) { background: var(--cyan-tint); color: var(--blue); }
  .ps-none { margin: 8px 0 0; font-size: 15px; color: var(--ink-3); }
</style>
