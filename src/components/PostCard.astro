---
import { formatDate } from '../lib/posts.js';
const { post, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<article class="card">
  <a href={`/${post.slug}/`} class="img" tabindex="-1" aria-hidden="true">
    {post.image
      ? <img src={post.imageSm || post.image} alt="" loading="lazy" width="800" height="421" />
      : <span class="ph"><span class="ph-k">{post.cluster || 'DRVN'}</span></span>}
  </a>
  <div class="body">
    <div class="eyebrow">{post.isNew ? `By ${post.author}` : formatDate(post.published)}</div>
    <H class="t"><a href={`/${post.slug}/`}>{post.title}</a></H>
    <p>{post.dek || post.description}</p>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; gap: 14px; }
  .img { display: block; border-radius: var(--radius); overflow: hidden; background: var(--surface-2); aspect-ratio: 1.9 / 1; }
  .img img { width: 100%; height: 100%; object-fit: cover; }
  .ph { display: flex; align-items: flex-end; width: 100%; height: 100%; padding: 18px; background: linear-gradient(135deg, var(--cyan-tint), #D4EEF9 60%, #BFE5F6); }
  .ph-k { font-size: 13px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--blue); }
  .body { display: flex; flex-direction: column; gap: 8px; }
  .t { font-size: 21px; line-height: 1.25; }
  .t a { color: var(--blue); text-decoration: none; }
  .t a:hover { text-decoration: underline; }
  p { margin: 0; font-size: 16px; line-height: 1.55; color: var(--ink-3); }
</style>
