---
// Forwarding page for a retired URL. An immediate meta refresh with a canonical to the
// destination is treated by Google as a permanent redirect.
import { SITE } from '../site.js';
const { to } = Astro.props;
const abs = new URL(to, SITE.url).href;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><title>Moved</title><meta name="robots" content="noindex" /><link rel="canonical" href={abs} /><meta http-equiv="refresh" content={`0; url=${to}`} /></head>
<body><p>This page has moved: <a href={to}>{abs}</a></p></body></html>
