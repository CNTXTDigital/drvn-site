---
// The six steps to a teen license for one state, from the verified requirements
// (data/guide/requirements.json). On a city page, pass `city` to localize the headings.
import { driversEdLink, SITE } from '../site.js';
import { CHECKED_LABEL } from '../lib/guide.js';

const { state: s, city } = Astro.props;
const r = s.req;
const name = s.sname;
const offer = driversEdLink(s.slug);
const host = (u) => {
  try {
    const x = new URL(u);
    const seg = x.pathname.split('/').filter(Boolean).pop() || '';
    const label = seg.replace(/\.(html?|aspx?|php|pdf)$/i, '').replace(/[-_]+/g, ' ').slice(0, 40);
    return x.hostname.replace(/^www\./, '') + (label ? ` · ${label}` : '');
  } catch { return u; }
};

const steps = [
  {
    t: `Driver’s ed in ${name}`,
    rows: [['Requirement', r.driversEd]],
    online: r.onlineDriversEd,
  },
  {
    t: `Get ${name === 'New Hampshire' ? 'started' : `${/^[AEIOU]/.test(name) ? 'an' : 'a'} ${name} learner’s permit`}`,
    rows: [['Minimum age', r.permitMinAge], ['The test', r.permitTest], ['What to bring', r.permitDocuments]],
  },
  {
    t: `Practice driving with a parent`,
    rows: [['Supervised hours', r.supervisedHours], ['Time on the permit', r.permitHoldingPeriod]],
    app: true,
  },
  {
    t: city ? `Pass the road test near ${city}` : `Pass the road test`,
    rows: [['Minimum age', r.licenseMinAge], ['The road test', r.roadTest]],
  },
  {
    t: `Know the rules for new drivers`,
    rows: [['Restrictions', r.restrictions]],
  },
  {
    t: `Add your teen to your car insurance`,
    rows: [
      ['When', 'Call your insurer as soon as your teen gets a permit. Some policies cover permit drivers automatically and others need them listed; rates usually rise once your teen is licensed.'],
      ['Save money', 'Ask about good-student and driver-training discounts, and compare quotes before your teen gets the first license.'],
    ],
  },
].map((st) => ({ ...st, rows: st.rows.filter(([, v]) => v && String(v).trim()) }));
---
<ol class="steps">
  {steps.map((st, i) => (
    <li id={`step${i + 1}`}>
      <span class="n">{i + 1}</span>
      <div class="body">
        <h2>{st.t}</h2>
        <dl>
          {st.rows.map(([k, v]) => <div class="row"><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
        {st.online && (
          <div class="online">
            <div>
              <p class="oh">Online driver’s ed for {name}</p>
              <p class="os">{offer.provider} offers state-certified online courses your teen can complete at home.</p>
            </div>
            <a class="btn btn-sm" href={offer.url} rel="sponsored noopener" target="_blank">Find an online driver’s ed course</a>
          </div>
        )}
        {st.app && (
          <div class="online app">
            <div>
              <p class="oh">Track every practice hour with DRVN</p>
              <p class="os">Log hours and routes as you drive, follow lesson plans for each stage, and check off skills. Free.</p>
            </div>
            <a class="btn btn-sm" href={SITE.appStore} rel="noopener">Get the app</a>
          </div>
        )}
      </div>
    </li>
  ))}
</ol>

<section class="verified" aria-label="Sources">
  <p class="vh">Checked {CHECKED_LABEL} against official {name} sources</p>
  <p class="vs">Rules change. Confirm the details with <a href={r.agencyUrl} rel="noopener" target="_blank">{r.agency}</a> before you go.</p>
  <ul>{r.sources.slice(0, 6).map((u) => <li><a href={u} rel="nofollow noopener" target="_blank">{host(u)}</a></li>)}</ul>
</section>

<style>
  .steps { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 22px; }
  .steps > li { display: flex; gap: 18px; align-items: flex-start; scroll-margin-top: 80px; }
  .n { flex: 0 0 40px; height: 40px; border-radius: 50%; background: var(--cyan-tint); color: var(--blue); font-weight: 800; display: grid; place-items: center; }
  .body { flex: 1; min-width: 0; padding-bottom: 22px; border-bottom: 1px solid var(--line); }
  .steps > li:last-child .body { border-bottom: 0; }
  h2 { font-size: 22px; margin: 6px 0 10px; }
  dl { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .row { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 12px; font-size: 16px; line-height: 1.55; }
  dt { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted-2); padding-top: 3px; }
  dd { margin: 0; color: var(--ink-2); }
  .online { margin-top: 14px; display: flex; gap: 16px; align-items: center; justify-content: space-between; background: var(--cyan-tint); border-radius: 12px; padding: 14px 16px; }
  .online.app { background: var(--surface-2); }
  .oh { margin: 0; font-weight: 700; color: var(--blue); font-size: 16px; }
  .os { margin: 2px 0 0; font-size: 14px; color: var(--ink-3); }
  .online .btn { flex: none; }
  .verified { margin-top: 18px; background: var(--surface-2); border-radius: 12px; padding: 16px 18px; font-size: 14px; color: var(--ink-3); }
  .vh { margin: 0; font-weight: 700; color: var(--ink); font-size: 15px; }
  .vs { margin: 4px 0 8px; }
  .verified ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 16px; }
  .verified ul a { font-size: 13px; }
  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; gap: 0; }
    .online { flex-direction: column; align-items: flex-start; }
    .steps > li { gap: 12px; }
    .n { flex-basis: 32px; height: 32px; font-size: 15px; }
  }
</style>
