---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, DRIVERS_ED } from '../site.js';
import { ORG, WEBSITE, breadcrumbLD } from '../lib/schema.js';
import { allPosts } from '../lib/posts.js';
// Readiness article paths, for the readiness_click analytics event.
// State driver's ed offers, so a generic partner link can switch to the parent's state at click time.
const ED_STATES = Object.fromEntries(Object.entries(DRIVERS_ED.states).map(([k, v]) => [k, v.url]));
const ED_DEFAULT = DRIVERS_ED.default.url;
const READINESS = allPosts.filter((p) => p.territory === 'readiness').map((p) => `/${p.slug}/`);

const {
  title,
  description = SITE.defaultDescription,
  image = '/og-default.png',
  imageAlt,
  type = 'website',
  published,
  modified,
  noindex = false,
  jsonld,
  fullTitle = false,
  canonicalPath,
  crumbs,
  bigLogo = false,
} = Astro.props;

const canonical = new URL(canonicalPath || Astro.url.pathname, SITE.url).href;
// Brand suffix only when it fits: Google shows roughly 60 characters of a title.
const pageTitle = fullTitle || `${title} | ${SITE.name}`.length > 60 ? title : `${title} | ${SITE.name}`;
// One JSON-LD graph per page: the organization and website, the page's own entities, and
// breadcrumbs (from the crumbs prop) unless the page supplies its own BreadcrumbList.
const pageNodes = !jsonld ? [] : jsonld['@graph'] ? jsonld['@graph'] : [Object.fromEntries(Object.entries(jsonld).filter(([k]) => k !== '@context'))];
const hasCrumbs = pageNodes.some((n) => n['@type'] === 'BreadcrumbList');
const graph = {
  '@context': 'https://schema.org',
  '@graph': [ORG, WEBSITE, ...pageNodes.filter((n) => n['@id'] !== ORG['@id']), ...(crumbs && !hasCrumbs && !noindex ? [breadcrumbLD(crumbs)] : [])],
};
const ogImage = new URL(image || '/og-default.png', SITE.url).href;
// Article images are 1600x842; the default card is 1200x630. Declaring the size lets
// Facebook and Messages draw the large preview on the first share instead of a thumbnail.
const ogSize = image && image !== '/og-default.png' ? [1600, 842] : [1200, 630];
const ogAlt = imageAlt || title;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}

  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={String(ogSize[0])} />
  <meta property="og:image:height" content={String(ogSize[1])} />
  <meta property="og:image:alt" content={ogAlt} />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {published && <meta property="article:published_time" content={published} />}
  {modified && <meta property="article:modified_time" content={modified} />}
  {type === 'article' && <meta property="article:author" content={`${SITE.url}/about/#founder`} />}
  {type === 'article' && SITE.social?.facebook && <meta property="article:publisher" content={SITE.social.facebook} />}

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" />

  {!noindex && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}

  <!-- Partner links: if a parent has chosen or viewed a state, a generic driver's ed link switches to
       that state's offer at click time; every partner link is tagged with where it was clicked
       (aff_sub = placement, aff_sub2 = page, aff_sub3 = state) so Aceable's report shows what converts. -->
  <script is:inline define:vars={{ edStates: ED_STATES, edDefault: ED_DEFAULT }}>
    (function(){
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a) return;
        var u; try { u = new URL(a.href, location.href); } catch (err) { return; }
        if (!/^go\.(aceable|driversed)\.com$/.test(u.hostname)) return;
        var state = ''; try { state = localStorage.getItem('drvn_state') || ''; } catch (err) {}
        if (u.href === edDefault && state && edStates[state]) u = new URL(edStates[state]);
        var holder = a.closest('[data-aff]');
        var placement = holder ? holder.getAttribute('data-aff') : (a.closest('.prose') ? 'article-inline' : 'other');
        u.searchParams.set('aff_sub', placement);
        u.searchParams.set('aff_sub2', location.pathname.slice(0, 90));
        if (state) u.searchParams.set('aff_sub3', state);
        a.href = u.href;
        a.setAttribute('data-placement', placement);
      }, true);
    })();
  </script>

  <!-- Analytics: GA4 (G-WJ7SMQ1RRQ) page views and events.
       Runs only on www.drvnapp.com. On staging, add ?ga_debug=1 to test (sends GA4 debug events). -->
  <script is:inline define:vars={{ ga4: SITE.ga4, readiness: READINESS }}>
    (function(){
      var prod = location.hostname === 'www.drvnapp.com';
      var dbg = false;
      try { if (/[?&]ga_debug=1/.test(location.search)) sessionStorage.setItem('ga_debug','1'); dbg = sessionStorage.getItem('ga_debug') === '1'; } catch (e) {}
      if (!prod && !dbg) return;
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag;
      var g = document.createElement('script'); g.async = true; g.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4; document.head.appendChild(g);
      gtag('js', new Date());
      // gtag sends page views itself. Google Tag Manager (GTM-WBTWZH2) was removed in October 2026:
      // its only tag loaded the old Sumo popup script from the WordPress site.
      gtag('config', ga4, dbg ? { debug_mode: true } : {});
      function send(name, params) { gtag('event', name, Object.assign({ page_path: location.pathname }, params || {})); }
      if (location.pathname === '/app/') send('app_page_view');
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a) return;
        var u; try { u = new URL(a.href, location.href); } catch (err) { return; }
        var text = (a.innerText || '').trim().replace(/\s+/g, ' ').slice(0, 100);
        var p = { link_url: u.href, link_text: text };
        var host = u.hostname.replace(/^www\./, '');
        if (host === 'apps.apple.com') return send('app_store_click', p);
        if (host === 'play.google.com') return send('google_play_click', p);
        if (/^go\.(aceable|driversed)\.com$/.test(u.hostname)) { p.provider = u.hostname.split('.')[1]; p.placement = a.getAttribute('data-placement') || ''; return send('affiliate_click', p); }
        var internal = host === 'drvnapp.com' || u.hostname === location.hostname;
        if (!internal) {
          if (a.closest('.prose, .sources, .src, .claim, .biblio, .verified')) { p.source_domain = host; return send('research_source_click', p); }
          return;
        }
        var path = u.pathname;
        if (location.pathname === '/learn/') {
          var sec = a.closest('[id].area');
          var hashSec = (u.hash && path === '/learn/') ? document.getElementById(u.hash.slice(1)) : null;
          var terr = (hashSec && hashSec.classList.contains('area')) ? hashSec.id : (sec ? sec.id : null);
          if (terr) send('learn_territory_click', { territory: terr, link_url: u.href, link_text: text });
        }
        if (path === '/teen-driving-safety/') return send('guide_click', p);
        if (readiness.indexOf(path) !== -1) return send('readiness_click', p);
        if (path.indexOf('/guide/') === 0) return send('state_guide_click', p);
        if (path === '/evidence/') return send('evidence_library_click', p);
        if (path === '/editorial-standards/') return send('editorial_standards_click', p);
        if (path === '/app/') return send('app_cta_click', p);
      }, true);
    })();
  </script>
</head>
<body>
  <a class="sr-only" href="#main">Skip to content</a>
  <Header big={bigLogo} />
  <main id="main"><slot /></main>
  <Footer />
</body>
</html>
