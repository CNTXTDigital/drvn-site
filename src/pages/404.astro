---
import Base from '../layouts/Base.astro';
import { states } from '../lib/guide.js';
// Old city guide URLs (/guide/{city}-{st}/) that aren't on the new site: point to the state guide.
const ST = Object.fromEntries(states.map((s) => [s.st.toLowerCase(), [s.slug, s.sname]]));
---
<Base title="Page not found" noindex>
  <section class="wrap nf">
    <div class="rule"></div>
    <h1>That page took a wrong turn.</h1>
    <p class="statehint" hidden></p>
    <p>It may have moved when we rebuilt the site. These are good places to pick back up:</p>
    <ul>
      <li><a href="/guide/">State Guides: your state's requirements</a></li>
      <li><a href="/learn/">Learn: guidance for parents</a></li>
      <li><a href="/">DRVN home</a></li>
    </ul>
  </section>
</Base>
<script is:inline define:vars={{ ST }}>
  (function () {
    var m = location.pathname.match(/^\/guide\/[a-z0-9-]+-([a-z]{2})\/?$/);
    var st = m && ST[m[1]];
    if (!st) return;
    var el = document.querySelector('.statehint');
    var a = document.createElement('a');
    a.href = '/guide/' + st[0] + '/';
    a.textContent = 'Go to the ' + st[1] + ' Teen Driving Guide →';
    el.appendChild(a);
    el.hidden = false;
  })();
</script>
<style>
  .nf { padding-top: 48px; max-width: 720px; display: flex; flex-direction: column; gap: 18px; }
  h1 { font-size: clamp(32px, 5vw, 48px); font-weight: 800; }
  p { margin: 0; font-size: 19px; color: var(--ink-3); }
  .statehint { font-size: 20px; font-weight: 700; }
  ul { margin: 0; padding-left: 1.2em; font-size: 18px; line-height: 2; }
</style>
