---
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import DriversEdCard from '../components/DriversEdCard.astro';
import { allPosts, formatDate, formatMonth, readingMinutes, related, relatedInTerritory } from '../lib/posts.js';
import { TERRITORY } from '../lib/learn.js';
import { SITE } from '../site.js';
import SourceList from '../components/SourceList.astro';
import HowWeKnow from '../components/HowWeKnow.astro';
import AuthorBox from '../components/AuthorBox.astro';
import { sourcesFor, claimsUsedIn, citationLD } from '../lib/evidence.js';
import { articleLD, breadcrumbLD } from '../lib/schema.js';

export function getStaticPaths() {
  return allPosts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const terr = post.territory ? TERRITORY[post.territory] : null;
const more = terr ? [] : related(post.slug, 4);
const inTerr = terr ? relatedInTerritory(post, 3, [terr.article, ...terr.links]) : [];
const url = `${SITE.url}/${post.slug}/`;
const sources = post.isNew ? sourcesFor(post.slug, post.sources) : [];
const claims = claimsUsedIn(post.slug);
const jsonld = {
  '@graph': [
    articleLD({ url, headline: post.title, description: post.description, image: post.image, published: post.published, modified: post.modified, citation: citationLD(sources), section: terr ? terr.label : post.cluster, byOrg: !post.author }),
    breadcrumbLD(terr ? [{ name: 'Learn', path: '/learn/' }, { name: terr.label, path: `/learn/${terr.id}/` }, { name: post.title, path: `/${post.slug}/` }] : [{ name: 'Articles', path: '/blog/' }, { name: post.title, path: `/${post.slug}/` }]),
  ],
};
---
<Base
  title={post.seoTitle || post.title}
  description={post.description}
  image={post.image}
  type="article"
  published={post.published}
  modified={post.modified}
  jsonld={jsonld}
>
  <div class="wrap layout">
    <article class="main">
      {terr
        ? <><nav class="bc" aria-label="Breadcrumb"><a href="/">DRVN</a><span>/</span><a href="/learn/">Learn</a><span>/</span><a href={`/learn/${terr.id}/`}>{terr.label}</a><span>/</span><span aria-current="page">{post.title.split(':')[0]}</span></nav><a class="terr" href={`/learn/${terr.id}/`}>{terr.label}</a></>
        : <nav class="bc" aria-label="Breadcrumb"><a href="/">DRVN</a><span>/</span><a href="/blog/">Articles</a></nav>}
      <h1>{post.title}</h1>
      {post.dek && <p class="dek">{post.dek}</p>}
      <div class="meta">
        {post.author && <><span class="by">By <a href="/about/#founder" rel="author">{post.author}</a></span><span>·</span>{terr && <><span>Founder, DRVN</span><span>·</span></>}</>}
        <span>{terr ? 'Published ' : ''}<time datetime={post.published}>{formatDate(post.published)}</time></span>
        {terr && <><span>·</span><span>Last reviewed: <time datetime={post.reviewed}>{formatMonth(post.reviewed)}</time></span></>}
        <span>·</span>
        <span>{readingMinutes(post.html)} min read</span>
      </div>
      {post.image && <img class="hero-img" src={post.image} srcset={post.imageSm ? `${post.imageSm} 800w, ${post.image} 1600w` : undefined} sizes="(max-width: 980px) 100vw, 680px" alt={post.imageAlt || ""} width="1600" height="842" fetchpriority="high" />}
      <div class="prose lede" set:html={post.html} />
      {terr && <AuthorBox />}
      {post.howWeKnow && <HowWeKnow />}
      {inTerr.length > 0 && (
        <section class="next" aria-labelledby="next-h">
          <h2 id="next-h">More on {terr.label}</h2>
          <div class="ncards">
            {inTerr.map((p) => (
              <a class="ncard" href={`/${p.slug}/`}>
                {p.imageSm && <img src={p.imageSm} alt="" width="800" height="421" loading="lazy" />}
                <div class="nb"><div class="nt">{p.title}</div><div class="nm">{readingMinutes(p.html)} min read</div></div>
              </a>
            ))}
          </div>
          <a class="link-arrow" href={`/learn/${terr.id}/`}>All {terr.label.replace(/^The /, "")} articles</a>
        </section>
      )}
      <SourceList sources={sources} claims={claims} />
    </article>

    <aside class="rail">
      <div class="sticky">
        <AppCard />
        <DriversEdCard />
        {more.length > 0 && <div class="more">
          <div class="eyebrow">More for parents</div>
          <ul>
            {more.map((p) => <li><a href={`/${p.slug}/`}>{p.title}</a></li>)}
          </ul>
        </div>}
        <div class="state">
          <p class="h">What does your state require?</p>
          <p>Permit age, supervised hours, night and passenger rules.</p>
          <a class="link-arrow" href="/guide/">State guide</a>
        </div>
      </div>
    </aside>
  </div>
</Base>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, var(--read)) 300px; gap: 56px; justify-content: space-between; padding-top: 28px; }
  .crumbs { display: flex; gap: 14px; align-items: center; }
  .crumbs a { font-size: 14px; font-weight: 600; text-decoration: none; }
  .terr { display: inline-block; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--blue); text-decoration: none; background: var(--cyan-tint); padding: 5px 10px; border-radius: 6px; }
  .terr:hover { color: var(--blue); background: #d3eefa; }
  .next { margin-top: 40px; padding-top: 22px; border-top: 1px solid var(--line); }
  .next h2 { font-size: 24px; margin: 0 0 14px; }
  .ncards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-bottom: 14px; }
  .ncard { display: flex; flex-direction: column; text-decoration: none; color: inherit; border: 1px solid var(--line-2); border-radius: 12px; overflow: hidden; background: var(--surface); }
  .ncard:hover { color: inherit; box-shadow: 0 14px 32px -22px rgba(10,108,165,.45); }
  .ncard img { width: 100%; aspect-ratio: 1.9 / 1; object-fit: cover; }
  .nb { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 4px; }
  .nt { font-size: 15px; font-weight: 700; line-height: 1.3; color: var(--ink); }
  .nm { font-size: 12.5px; color: var(--muted); }
  @media (max-width: 640px) { .ncards { grid-template-columns: 1fr; } .ncard { flex-direction: row; } .ncard img { width: 112px; aspect-ratio: auto; flex: 0 0 112px; } }
  .dek { margin: 0 0 14px; font-size: 24px; line-height: 1.4; color: var(--ink-3); font-weight: 500; }
  .by { color: var(--ink-2); font-weight: 600; }
  .by a { color: inherit; text-decoration: none; }
  .by a:hover { color: var(--blue); }
  .crumbs a::before { content: '← '; }
  h1 { font-size: clamp(32px, 4.5vw, 46px); font-weight: 800; letter-spacing: -0.022em; line-height: 1.1; margin: 12px 0 12px; text-wrap: pretty; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: 15px; color: var(--muted); margin-bottom: 20px; }
  .meta > * { white-space: nowrap; }
  .hero-img { width: 100%; border-radius: 14px; margin-bottom: 28px; aspect-ratio: 1.9/1; object-fit: cover; background: var(--surface-2); }
  .rail { padding-top: 40px; }
  .sticky { position: sticky; top: 84px; display: flex; flex-direction: column; gap: 16px; }
  .more ul { list-style: none; margin: 12px 0 0; padding: 0; }
  .more li { border-bottom: 1px solid var(--line); }
  .more li:last-child { border-bottom: 0; }
  .more a { display: block; padding: 11px 0; font-size: 15px; line-height: 1.4; font-weight: 600; text-decoration: none; color: var(--ink-2); }
  .more a:hover { color: var(--blue); }
  .state { background: var(--surface-2); border-radius: 12px; padding: 18px 20px; font-size: 14px; color: var(--ink-3); }
  .state .h { margin: 0 0 4px; font-weight: 700; color: var(--ink); font-size: 15px; }
  .state p { margin: 0 0 10px; }
  @media (max-width: 980px) {
    .layout { grid-template-columns: 1fr; gap: 40px; padding-top: 32px; }
    .rail { padding-top: 0; }
    .sticky { position: static; }
  }
</style>
