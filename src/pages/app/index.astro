---
// DRVN App page. Built from the approved "DRVN App Page" design canvas (Oct 11, 2026).
// Hero, founder note, how a drive works (six steps), eight lessons, both seats,
// readiness, FAQ, final CTA. The header and footer come from the site layout.
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.js';
import { APP_ID, ORG_ID, FOUNDER_ID } from '../../lib/schema.js';

const lessons = [
  'Basic Vehicle Ops', 'Basic Control Tasks', 'Intermediate Control Tasks', 'Advanced Control Tasks',
  'Maneuverability', 'Traffic Control Devices', 'Highway Management', 'Perception & Driving Strategies',
];
const faqs = [
  { q: 'Is DRVN really free?', a: 'Yes. Free for parents and teens, on iPhone and Android.' },
  { q: 'Does my teen need the app too?', a: 'Yes. Your teen pairs as the driver. That gives them their own view of their progress, plus the lesson content and a quick quiz after each lesson.' },
  { q: 'Will the log count toward my state’s required hours?', a: 'DRVN keeps a complete record of every drive. How you submit hours depends on your state, and your <a href="/guide/">state guide</a> spells it out.' },
  { q: 'Can more than one adult coach?', a: 'Yes. Both parents, a grandparent, a driving instructor: anyone who rides along can sign up as a coach for your teen. For now, each account follows one teen driver. Support for coaching more than one teen is on our roadmap.' },
  { q: 'What happens to our driving data?', a: 'Only you, your teen and the other coaches you’ve added can see your drives and progress. We never share your data. You can ask us to delete your account at any time by emailing <a href="mailto:info@drvnapp.com">info@drvnapp.com</a>.' },
];
const strip = (h) => h.replace(/<[^>]+>/g, '');
const jsonld = {
  '@graph': [
    {
      '@type': ['SoftwareApplication', 'MobileApplication'],
      '@id': APP_ID,
      name: 'DRVN',
      url: `${SITE.url}/app/`,
      description: 'A practice-driving plan and log for parents teaching a teen to drive: pick one thing to work on before each drive, log drive time, night time, miles and the route while you drive, and see where you have actually been.',
      operatingSystem: 'iOS, Android',
      applicationCategory: 'EducationalApplication',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      installUrl: [SITE.appStore, SITE.googlePlay],
      downloadUrl: [SITE.appStore, SITE.googlePlay],
      screenshot: ['drive-summary', 'skill-detail', 'welcome', 'rate-drive', 'drive-log-v2', 'home'].map((n) => `${SITE.url}/images/app/${n}.jpg`),
      publisher: { '@id': ORG_ID },
      author: { '@id': ORG_ID },
      creator: { '@id': FOUNDER_ID },
      audience: { '@type': 'Audience', audienceType: 'Parents of teen drivers' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: strip(f.a) } })),
    },
  ],
};
const apple = 'M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.7-1-2.7-4.1zM13.9 5c.7-.9 1.2-2 1-3.2-1 .1-2.2.7-2.9 1.6-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4z';
---
<Base
  title="DRVN App | A Plan for Every Teen Practice Drive"
  fullTitle
  description="Know what to work on before you back out of the driveway, let DRVN log the drive, and see everywhere you've been. Free for parents and teens on iOS and Android."
  image="/images/app/drive-summary.jpg"
  jsonld={jsonld}
  crumbs={[{ name: 'DRVN app', path: '/app/' }]}
>
  <div class="appg">
    <!-- Hero -->
    <section class="hero">
      <div class="wrap hero-in">
        <div class="hero-copy">
          <div class="kick">The DRVN app</div>
          <h1>A plan for every drive.</h1>
          <p class="hlead">Know what to work on before you back out of the driveway. Let DRVN log the drive while you ride along. Then see everywhere you’ve actually been, so fifty hours adds up to real experience.</p>
          <div id="get" class="get">
            <a class="badge" href={SITE.appStore}>
              <svg width="22" height="26" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d={apple}></path></svg>
              <div><small>Download on the</small><span>App Store</span></div>
            </a>
            <a class="badge" href={SITE.googlePlay}>
              <svg width="22" height="24" viewBox="0 0 24 26" aria-hidden="true"><path d="M2 1.5l12 11.5L2 24.5c-.5-.3-.8-.8-.8-1.5V3c0-.7.3-1.2.8-1.5z" fill="#41B6E5"></path><path d="M18 9l-4 4-12-11.5c.4-.3 1-.3 1.6 0z" fill="#86B404"></path><path d="M18 17l-4-4-12 11.5c.4.3 1 .3 1.6 0z" fill="#E8475F"></path><path d="M22 11.4c.9.6.9 2 0 2.6L18 17l-4-4 4-4z" fill="#FCC749"></path></svg>
              <div><small>Get it on</small><span>Google Play</span></div>
            </a>
            <a class="how-link" href="#how">See how a drive works ↓</a>
          </div>
          <div class="micro"><span>Free for parents and teens</span><span aria-hidden="true">·</span><span>iOS and Android</span><span aria-hidden="true">·</span><span>1,500+ young drivers trained with DRVN</span></div>
        </div>
        <div class="hero-vis">
          <div class="phone tall back"><img src="/images/app/skill-detail.jpg" alt="Skill detail: Front First Two-Point Turnaround, with five steps and a diagram" width="750" height="1642" /></div>
          <div class="phone tall front"><img src="/images/app/drive-summary.jpg" alt="A drive's route on a map, with drive time, night time, miles and the skills covered" width="750" height="1697" fetchpriority="high" /></div>
        </div>
      </div>
    </section>

    <!-- Founder note -->
    <section class="founder">
      <div class="wrap split">
        <h2 class="h2">Most of us get in the car with no plan.</h2>
        <div class="fcol">
          <p class="body big">I did. You drive to school, to practice, to the store. A few months in, it feels like you’ve done fifty hours.</p>
          <p class="body big">With one of our younger kids, DRVN had logged fifteen. My wife couldn’t believe it. “It feels like fifty.” It does feel like fifty. That’s the problem, and it’s why I built this.</p>
          <div class="sig">
            <span class="av" aria-hidden="true">RA</span>
            <div><strong>Robert Abbott</strong><br /><span>Founder of DRVN. Taught four kids to drive.</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- How a drive works -->
    <section id="how" class="how">
      <div class="wrap how-head">
        <div class="kick">How a drive works</div>
        <h2 class="h2xl">From the driveway and back again.</h2>
        <p class="body">Here’s what using DRVN actually looks like, one drive at a time.</p>
      </div>
      <div class="wrap">
        <ol class="lane">
          <li class="step">
            <div class="step-text">
              <div class="when"><span class="num">1</span>Once, at the start</div>
              <h3 class="h3">Pair up in two minutes.</h3>
              <p class="body">Download DRVN, tell it whether you’re the coach or the driver, and pair with your teen. From then on, every drive lands in one shared record.</p>
            </div>
            <div class="step-vis"><div class="phone"><img src="/images/app/welcome.jpg" alt="Welcome to DRVN. Are you a Coach or Driver?" width="750" height="1334" loading="lazy" /></div></div>
          </li>
          <li class="step rev">
            <div class="step-text">
              <div class="when"><span class="num">2</span>Before you pull out</div>
              <h3 class="h3">Pick one thing to work on.</h3>
              <p class="body">Every lesson breaks into skills, and every skill into a few plain steps with a diagram. Read it in the driveway, and you’re not making up instructions at a red light.</p>
              <div class="tip"><b>From the passenger seat</b>Two minutes of planning beats twenty minutes of “Okay, now turn… here?”</div>
            </div>
            <div class="step-vis"><div class="phone tall"><img src="/images/app/skill-detail.jpg" alt="Skill detail with numbered steps and a turnaround diagram" width="750" height="1642" loading="lazy" /></div></div>
          </li>
          <li class="step">
            <div class="step-text">
              <div class="when"><span class="num">3</span>While you drive</div>
              <h3 class="h3">Tap start. Then put the phone down.</h3>
              <p class="body">DRVN logs drive time, night time, miles and the route in the background. Your attention stays where it belongs: on the road, and on the kid.</p>
              <div class="tip"><b>From the passenger seat</b>Good time to say the phone rule out loud. Theirs stays put too.</div>
            </div>
            <div class="step-vis"><div class="crop"><img src="/images/app/start-drive.jpg" alt="Lesson 1 card and a Start Your First Drive button" width="750" height="646" loading="lazy" /></div></div>
          </li>
          <li class="step rev">
            <div class="step-text">
              <div class="when"><span class="num">4</span>When you park</div>
              <h3 class="h3">Three taps on how it went.</h3>
              <p class="body">Room for improvement, almost there, or awesome. You make the call. DRVN keeps track, so you remember which skills need another pass.</p>
            </div>
            <div class="step-vis"><div class="phone"><img src="/images/app/rate-drive.jpg" alt="Rate the drive: Room for Improvement, Almost There, or Awesome" width="750" height="1334" loading="lazy" /></div></div>
          </li>
          <li class="step">
            <div class="step-text">
              <div class="when"><span class="num">5</span>Looking back</div>
              <h3 class="h3">See where you’ve actually been.</h3>
              <p class="body">Every drive shows up on a map with drive time, night time, miles and the skills it covered. Forty trips to the same school parking lot will look like exactly that.</p>
              <div class="tip"><b>From the passenger seat</b>Fifty hours on the same three roads isn’t fifty hours of experience.</div>
            </div>
            <div class="step-vis"><div class="phone tall"><img src="/images/app/drive-summary.jpg" alt="Drive 6 summary with route map and skills covered" width="750" height="1697" loading="lazy" /></div></div>
          </li>
          <li class="step rev">
            <div class="step-text">
              <div class="when"><span class="num">6</span>Week after week</div>
              <h3 class="h3">Watch the season add up.</h3>
              <p class="body">Every drive sits in one log. Home keeps the totals in view: drive time, night time, miles, and the lesson you’re on.</p>
            </div>
            <div class="step-vis pair">
              <div class="phone tall sm"><img src="/images/app/drive-log-v2.jpg" alt="Previous drives log with miles and minutes for each drive" width="750" height="1334" loading="lazy" /></div>
              <div class="phone tall sm down"><img src="/images/app/home.jpg" alt="DRVN home screen with total drive time, night drive time, miles, the current lesson and the last drive" width="750" height="1333" loading="lazy" /></div>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- Lesson arc -->
    <section class="arc-band">
      <div class="wrap arc-in">
        <div class="arc-head">
          <h2>Eight lessons. Easy roads first.</h2>
          <p>Start with the basics in an empty lot. Finish on the highway, reading the road ahead. You always know where you are in the arc.</p>
        </div>
        <ol class="arc">
          {lessons.map((l, i) => <li><span class="ln">Lesson {i + 1}</span><span class="lt">{l}</span></li>)}
        </ol>
      </div>
    </section>

    <!-- Both seats -->
    <section class="seats">
      <div class="wrap seats-in">
        <div class="seats-head">
          <img src="/images/app/both-seats.png" alt="Illustration of a parent and teen in a car" width="410" height="422" loading="lazy" />
          <div class="seats-copy">
            <h2 class="h2xl">Built for both seats.</h2>
            <p class="body">You’re the coach. Your teen is the driver. You each see what you need, and nobody has to keep a notebook in the glovebox.</p>
          </div>
        </div>
        <div class="cols">
          <div class="col coach">
            <div class="kick">The coach (you)</div>
            <ul>
              <li>Pick tonight’s focus before you go</li>
              <li>Ride along while DRVN keeps the log</li>
              <li>Rate how it went in three taps</li>
              <li>See every drive, every road and every hour in one place</li>
            </ul>
          </div>
          <div class="col driver">
            <div class="kick">The driver (your teen)</div>
            <ul>
              <li>Read the lessons and take the follow-up quizzes</li>
              <li>See what’s coming up next</li>
              <li>Watch the hours and miles add up</li>
              <li>Know which skills they’ve covered and which are still ahead</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Readiness -->
    <section class="ready">
      <div class="wrap split">
        <h2 class="h2xl">The state sets eligibility. You set readiness.</h2>
        <div class="fcol">
          <p class="body">Your state decides how many hours count. You decide whether your teen is actually ready to drive alone.</p>
          <p class="body">DRVN won’t make that call for you. It makes sure you make it with the whole record in front of you: the hours, the night driving, the roads you’ve covered and the ones you haven’t.</p>
          <a class="more" href="/is-my-teen-ready-to-drive-alone/#drvn-readiness-framework">The five parts of readiness →</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faqs">
      <div class="wrap split">
        <h2 class="h2">Questions parents ask</h2>
        <div class="faq-list">
          {faqs.map((f) => <div class="faq"><h3>{f.q}</h3><p set:html={f.a} /></div>)}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="final">
      <div class="wrap final-in">
        <h2>You’ll spend fifty hours in the passenger seat anyway. Make them count.</h2>
        <div class="get center">
          <a class="badge" href={SITE.appStore}>
            <svg width="22" height="26" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d={apple}></path></svg>
            <div><small>Download on the</small><span>App Store</span></div>
          </a>
          <a class="badge" href={SITE.googlePlay}>
            <svg width="22" height="24" viewBox="0 0 24 26" aria-hidden="true"><path d="M2 1.5l12 11.5L2 24.5c-.5-.3-.8-.8-.8-1.5V3c0-.7.3-1.2.8-1.5z" fill="#41B6E5"></path><path d="M18 9l-4 4-12-11.5c.4-.3 1-.3 1.6 0z" fill="#86B404"></path><path d="M18 17l-4-4-12 11.5c.4.3 1 .3 1.6 0z" fill="#E8475F"></path><path d="M22 11.4c.9.6.9 2 0 2.6L18 17l-4-4 4-4z" fill="#FCC749"></path></svg>
            <div><small>Get it on</small><span>Google Play</span></div>
          </a>
        </div>
        <div class="final-links">
          <a href="/guide/">Find your state guide →</a>
          <a href="/choosing-a-drivers-ed-course/">Looking for a driver’s ed class? →</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .appg { --navy: #0F3B5C; --ink-b: #33414E; --sky: #EAF7FC; --purple: #6537A3; }
  .appg .wrap { max-width: 1200px; }
  .kick { font-size: 14px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--blue); }
  .body { margin: 0; font-size: 19px; line-height: 1.6; color: var(--ink-b); max-width: 34em; }
  .body.big { font-size: 21px; }
  .h2 { margin: 0; font-size: clamp(30px, 3.4vw, 44px); line-height: 1.1; font-weight: 800; color: var(--navy); text-wrap: balance; }
  .h2xl { margin: 0; font-size: clamp(34px, 4.4vw, 56px); line-height: 1.05; font-weight: 900; color: var(--navy); letter-spacing: -.01em; text-wrap: balance; }
  .split { display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: flex-start; }
  .split > :first-child { flex: 1 1 320px; min-width: 0; }
  .fcol { flex: 1.4 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }

  /* Phones */
  .phone { width: 100%; max-width: 270px; border: 10px solid #18222D; border-radius: 38px; overflow: hidden; background: #fff; box-shadow: 0 30px 60px -24px rgba(10,60,100,.35); box-sizing: border-box; line-height: 0; }
  .phone img { width: 100%; height: auto; display: block; }
  /* Every phone shows the same 9:16 screen; taller screenshots are cropped from the top. */
  .phone img { aspect-ratio: 9 / 16; object-fit: cover; object-position: top; }
  .phone.sm { max-width: 220px; }
  .crop { width: 100%; max-width: 400px; border-radius: 22px; overflow: hidden; line-height: 0; box-shadow: 0 30px 60px -24px rgba(10,60,100,.35); }
  .crop img { width: 100%; height: auto; display: block; }

  /* Badges */
  .get { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .get.center { justify-content: center; }
  .badge { display: inline-flex; align-items: center; gap: 10px; background: #111; color: #fff; border-radius: 12px; padding: 10px 18px; min-height: 44px; text-decoration: none; box-sizing: border-box; }
  .badge:hover { color: #fff; background: #2a2a2a; }
  .badge small { display: block; font-size: 11px; line-height: 1.1; opacity: .85; }
  .badge span { display: block; font-size: 19px; font-weight: 700; line-height: 1.1; }

  /* Hero */
  .hero { background: var(--sky); overflow: hidden; }
  .hero-in { display: flex; flex-wrap: wrap; align-items: center; gap: 48px; padding-top: 48px; }
  .hero-copy { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 20px; padding-bottom: 56px; }
  .hero h1 { margin: 0; font-size: clamp(44px, 6vw, 76px); line-height: 1; font-weight: 900; color: var(--navy); letter-spacing: -.02em; text-wrap: balance; }
  .hlead { margin: 0; font-size: clamp(19px, 1.8vw, 23px); line-height: 1.5; color: var(--ink-b); max-width: 30em; }
  .how-link { font-size: 17px; font-weight: 700; text-decoration: none; padding: 10px 6px; }
  .micro { font-size: 15px; color: #4C5D6B; display: flex; flex-wrap: wrap; gap: 6px 16px; }
  .hero-vis { flex: 1 1 420px; min-width: 0; display: flex; justify-content: center; align-items: flex-end; position: relative; min-height: 440px; }
  .hero-vis .back { max-width: 240px; transform: translate(36px, -40px) rotate(-5deg); opacity: .97; }
  .hero-vis .front { max-width: 290px; position: relative; margin-bottom: -60px; }

  /* Founder */
  .founder { padding: 64px 0 8px; }
  .sig { display: flex; align-items: center; gap: 14px; margin-top: 6px; font-size: 16px; line-height: 1.4; }
  .sig strong { color: var(--navy); }
  .sig span:not(.av) { color: #4C5D6B; }
  .av { width: 48px; height: 48px; border-radius: 50%; background: #D8E7F0; color: var(--blue); display: flex; align-items: center; justify-content: center; font-weight: 800; flex: none; }

  /* How a drive works */
  .how { padding: 56px 0 16px; scroll-margin-top: 70px; }
  .how-head { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; padding-bottom: 40px; }
  .lane { list-style: none; margin: 0; padding: 0 0 0 clamp(20px, 4vw, 48px); border-left: 4px dashed #FCC749; display: flex; flex-direction: column; gap: 72px; }
  .step { display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: center; }
  .step.rev { flex-direction: row-reverse; }
  .step-text { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  .step-vis { flex: 1 1 320px; min-width: 0; display: flex; justify-content: center; gap: 24px; }
  .step-vis.pair { flex-wrap: wrap; }
  .step-vis .down { margin-top: 48px; }
  .when { display: flex; align-items: center; gap: 12px; font-size: 13px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--blue); }
  .num { width: 40px; height: 40px; border-radius: 50%; background: #41B6E5; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 900; letter-spacing: 0; flex: none; }
  .h3 { margin: 0; font-size: clamp(28px, 3.2vw, 40px); line-height: 1.1; font-weight: 800; color: var(--navy); text-wrap: balance; }
  .tip { position: relative; max-width: 30em; background: var(--purple); color: #fff; border-radius: 14px; padding: 18px 22px; font-size: 17px; line-height: 1.45; font-weight: 500; margin-top: 6px; }
  .tip::before { content: ""; position: absolute; left: 28px; top: -9px; width: 18px; height: 18px; background: var(--purple); transform: rotate(45deg); border-radius: 3px; }
  .tip b { display: block; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; font-weight: 800; opacity: .85; margin-bottom: 6px; }

  /* Lesson arc */
  .arc-band { background: var(--blue); color: #fff; padding: 64px 0; margin-top: 48px; }
  .arc-in { display: flex; flex-direction: column; gap: 40px; }
  .arc-head { display: flex; flex-wrap: wrap; gap: 16px 64px; align-items: flex-end; justify-content: space-between; }
  .arc-head h2 { margin: 0; font-size: clamp(32px, 4vw, 50px); line-height: 1.05; font-weight: 900; flex: 1 1 380px; text-wrap: balance; color: #fff; }
  .arc-head p { margin: 0; font-size: 19px; line-height: 1.6; max-width: 30em; flex: 1 1 340px; color: #DCEFF9; }
  .arc { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2px; background: rgba(255,255,255,.18); border-radius: 16px; overflow: hidden; }
  .arc li { background: var(--blue); padding: 22px; display: flex; flex-direction: column; gap: 6px; }
  .ln { font-size: 13px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #86D3F2; }
  .lt { font-size: 20px; font-weight: 700; }

  /* Both seats */
  .seats { padding: 72px 0; }
  .seats-in { display: flex; flex-direction: column; gap: 32px; }
  .seats-head { display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: center; }
  .seats-head img { width: 100%; max-width: 260px; height: auto; flex: none; }
  .seats-copy { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 24px; }
  .col { border-radius: 20px; padding: 32px; display: flex; flex-direction: column; gap: 16px; }
  .col.coach { background: var(--sky); }
  .col.driver { background: #F2F7E4; }
  .col.driver .kick { color: #4F6B00; }
  .col ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 10px; font-size: 19px; line-height: 1.5; color: var(--ink-b); }

  /* Readiness */
  .ready { background: #F6F9FB; padding: 64px 0; }
  .more { font-size: 18px; font-weight: 700; text-decoration: none; }
  .more:hover { text-decoration: underline; }

  /* FAQ */
  .faqs { padding: 64px 0; }
