---
import Base from '../../layouts/Base.astro';
import BlogList from '../../components/BlogList.astro';
import { allPosts } from '../../lib/posts.js';
import { POSTS_PER_PAGE } from '../../site.js';

const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
---
<Base title="Articles for parents teaching a teen to drive" description="Practical articles for parents teaching a teen to drive: practice plans, the 50-hour rule, night and weather driving, and the move to solo driving.">
  <BlogList posts={allPosts.slice(0, POSTS_PER_PAGE)} page={1} totalPages={totalPages} />
</Base>
