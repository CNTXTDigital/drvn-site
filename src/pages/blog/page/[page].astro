---
// The paginated list is gone; /blog/ shows every article. These old WordPress-era
// /blog/page/N/ URLs now forward to /blog/ (noindex, canonical, instant refresh).
export function getStaticPaths() {
  return Array.from({ length: 11 }, (_, i) => ({ params: { page: String(i + 2) } }));
}
