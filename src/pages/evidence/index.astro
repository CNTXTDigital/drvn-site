---
// The DRVN evidence library. Content lives in src/data/evidence.json; articles cite the same
// source ids, so a figure is updated in one place. Review every source each October.
import Base from '../../layouts/Base.astro';
import { EVIDENCE, GROUPS, SOURCES, CLAIMS } from '../../lib/evidence.js';
import { allPosts } from '../../lib/posts.js';
import { SITE } from '../../site.js';
import { ORG_ID, SITE_ID, AUTHOR_REF } from '../../lib/schema.js';

const titles = Object.fromEntries(allPosts.map((p) => [p.slug, p.title]));
titles['teen-driving-safety'] = 'Teen Driving Safety for Parents';
const host = (u) => new URL(u).hostname.replace(/^www\./, '');
const url = `${SITE.url}/evidence/`;
const allSources = Object.entries(SOURCES).map(([id, s]) => ({ id, ...s }));

const jsonld = {
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${url}#webpage`,
      url,
      name: 'The DRVN evidence library',
      description: 'The research behind DRVN’s guidance for parents teaching a teen to drive, with the primary source, the figures and the limits of each finding.',
      isPartOf: { '@id': SITE_ID },
      publisher: { '@id': ORG_ID },
      author: AUTHOR_REF,
      dateModified: '2026-10-11',
      lastReviewed: '2026-10-11',
      copyrightHolder: { '@id': ORG_ID },
      inLanguage: 'en-US',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: CLAIMS.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          item: {
            '@type': 'Claim',
            '@id': `${url}#${c.id}`,
            url: `${url}#${c.id}`,
            text: c.claim,
            appearance: c.sources.map((id) => ({ '@type': 'CreativeWork', name: SOURCES[id].title, url: SOURCES[id].url, publisher: { '@type': 'Organization', name: SOURCES[id].org } })),
          },
        })),
      },
    },
  ],
};
---
<Base
  title="Evidence library: the research behind DRVN"
  description="The research behind DRVN’s advice for parents teaching a teen to drive: when crash risk peaks, what state requirements cover, what varied practice does, and what it costs, each with the primary source and its limits."
  jsonld={jsonld}
  crumbs={[{ name: 'Evidence library', path: '/evidence/' }]}
>
  <section class="top">
    <div class="wrap head">
      <div class="eyebrow blue">Evidence library</div>
      <h1>The research behind DRVN.</h1>
      <p class="lede">Every claim DRVN makes about teen driving risk, practice and cost, with the primary source, the actual figures and the limits of each finding. Our articles cite this library, so when a number changes, it changes here first.</p>
      <div class="meta">
        <span>Maintained by <a href="/about/#founder">Robert Abbott</a> and DRVN</span>
        <span>Sources checked {EVIDENCE.checked}</span>
        <span><a href="/about/#standards">Our editorial standards</a></span>
      </div>
    </div>
  </section>

  <div class="wrap layout">
    <nav class="toc" aria-label="Topics">
      <div class="eyebrow">Topics</div>
      <ol>{GROUPS.map((g) => <li><a href={`#${g.id}`}>{g.title}</a></li>)}</ol>
      <a class="all" href="#all-sources">All sources ({allSources.length})</a>
    </nav>

    <div class="main">
      {GROUPS.map((g) => (
        <section class="group" id={g.id}>
          <h2>{g.title}</h2>
          <p class="gi">{g.intro}</p>
          {g.claims.map((c) => (
            <article class="claim" id={c.id}>
              <h3><a href={`#${c.id}`}>{c.claim}</a></h3>
              <p class="ev">{c.evidence}</p>
              <dl>
                <div><dt>Evidence type</dt><dd>{c.strength}</dd></div>
                {c.caveat && <div><dt>Limits</dt><dd>{c.caveat}</dd></div>}
                <div>
                  <dt>Sources</dt>
                  <dd>
                    <ul class="src">
                      {c.sources.map((id) => {
                        const s = SOURCES[id];
                        return <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a> <span class="o">{s.org}{s.date ? `, ${s.date}` : ''}</span></li>;
                      })}
                    </ul>
                  </dd>
                </div>
                {c.usedIn.length > 0 && (
                  <div>
                    <dt>Used in</dt>
                    <dd>{c.usedIn.map((slug, i) => <>{i > 0 && ' · '}<a href={`/${slug}/`}>{titles[slug] || slug}</a></>)}</dd>
                  </div>
                )}
              </dl>
            </article>
          ))}
        </section>
      ))}

      <section class="group" id="all-sources">
        <h2>All sources</h2>
        <p class="gi">Primary sources first: peer-reviewed studies, federal and state agencies, and the Insurance Institute for Highway Safety. Industry analyses are used only for insurance costs.</p>
        <ol class="biblio">
          {allSources.map((s) => (
            <li id={`source-${s.id}`}>
              {s.authors && <>{s.authors} </>}<a href={s.url} rel="noopener" target="_blank">{s.title}</a>. {s.org}{s.date && <>, {s.date}</>}.
              {s.doi && <> <a href={`https://doi.org/${s.doi}`} rel="noopener" target="_blank">doi:{s.doi}</a>.</>}
              <span class="k"> {s.kind} · {host(s.url)}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="group how" id="how">
        <h2>How we maintain this library</h2>
        <ul>
          <li><b>Primary sources only.</b> We link the study, the agency page or the state’s own site, not news coverage of them.</li>
          <li><b>Figures as published.</b> Numbers match the source’s wording and data year. Where sources disagree, we say so.</li>
          <li><b>Limits stated.</b> Sample sizes, study design, funding and statistical uncertainty are noted beside the finding, not buried.</li>
          <li><b>Law, research and our advice kept separate.</b> What a state requires, what the research shows and what we recommend as parents are labeled as such.</li>
          <li><b>Reviewed every year.</b> Every source is rechecked each October, and insurance figures are refreshed when new rate data is published.</li>
        </ul>
        <p>Spotted something out of date or know of research we should include? <a href="mailto:info@drvnapp.com?subject=Evidence%20library">Email info@drvnapp.com</a>.</p>
      </section>
    </div>
  </div>
</Base>

<style>
  .eyebrow.blue { color: var(--blue); }
  .top { background: linear-gradient(var(--surface-2), var(--surface)); border-bottom: 1px solid var(--line); }
  .head { padding-top: 40px; padding-bottom: 36px; display: flex; flex-direction: column; gap: 12px; }
  h1 { font-size: clamp(36px, 4.6vw, 54px); font-weight: 800; line-height: 1.05; letter-spacing: -0.026em; }
  .lede { margin: 0; font-size: 20px; line-height: 1.5; color: var(--ink-2); max-width: 38em; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: 14.5px; color: var(--muted); }
  .layout { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 48px; padding-top: 32px; }
  .toc { position: sticky; top: 92px; align-self: start; font-size: 15px; }
  .toc ol { margin: 10px 0 14px; padding-left: 1.2em; }
  .toc li { margin: 8px 0; line-height: 1.35; }
  .toc a { color: var(--ink-2); text-decoration: none; font-weight: 600; }
  .toc a:hover { color: var(--blue); }
  .toc .all { font-size: 14px; color: var(--blue); }
  .main { max-width: 780px; }
  .group { padding-bottom: 20px; scroll-margin-top: 84px; }
  .group h2 { font-size: 30px; font-weight: 800; margin: 8px 0 6px; }
  .gi { margin: 0 0 14px; color: var(--ink-3); font-size: 17px; }
  .claim { border: 1px solid var(--line-2); border-radius: 16px; padding: 20px 22px; margin: 0 0 16px; scroll-margin-top: 84px; background: var(--surface); }
  .claim:target { border-color: var(--cyan); box-shadow: 0 0 0 3px var(--cyan-tint); }
  .claim h3 { font-size: 20px; font-weight: 800; line-height: 1.3; margin: 0 0 8px; }
  .claim h3 a { color: var(--ink); text-decoration: none; }
  .claim h3 a:hover { color: var(--blue); }
  .ev { margin: 0 0 12px; font-size: 16.5px; line-height: 1.6; color: var(--ink-2); }
  dl { margin: 0; display: grid; gap: 8px; font-size: 14.5px; line-height: 1.5; }
  dl > div { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 12px; }
  dt { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted-2); padding-top: 2px; }
  dd { margin: 0; color: var(--ink-3); }
  .src { margin: 0; padding: 0; list-style: none; }
  .src li { margin: 0 0 4px; overflow-wrap: anywhere; }
  .o { color: var(--muted); }
  .biblio { padding-left: 1.4em; font-size: 15px; line-height: 1.55; color: var(--ink-3); }
  .biblio li { margin: 8px 0; overflow-wrap: anywhere; scroll-margin-top: 84px; }
  .k { color: var(--muted-2); font-size: 13.5px; }
  .how ul { padding-left: 1.2em; font-size: 16.5px; line-height: 1.6; color: var(--ink-2); }
  .how li { margin: 6px 0; }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; gap: 16px; }
    .toc { position: static; border: 1px solid var(--line-2); border-radius: 14px; padding: 14px 16px; }
    dl > div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
