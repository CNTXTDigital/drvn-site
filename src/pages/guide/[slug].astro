---
// State guides (/guide/ohio/) and city guides (/guide/columbus-oh/) — same URLs as the old site.
import Base from '../../layouts/Base.astro';
import AppCard from '../../components/AppCard.astro';
import DriversEdCard from '../../components/DriversEdCard.astro';
import StateSteps from '../../components/StateSteps.astro';
import StatePicker from '../../components/StatePicker.astro';
import CityProfile from '../../components/CityProfile.astro';
import profiles from '../../data/guide/city-profiles.json';
import { states, stateBySt, cities, citiesBySt, CHECKED_LABEL } from '../../lib/guide.js';
import PlaceSearch from '../../components/PlaceSearch.astro';
import { SITE } from '../../site.js';

export function getStaticPaths() {
  return [
    ...states.map((s) => ({ params: { slug: s.slug }, props: { kind: 'state', st: s.st } })),
    ...cities.map((c) => ({ params: { slug: c.slug }, props: { kind: 'city', st: c.st, city: c } })),
  ];
}

const { kind, st, city } = Astro.props;
const s = stateBySt[st];
const c = kind === 'city' ? city : null;
const profile = c ? profiles[c.slug] : null;
const otherCities = citiesBySt[st] || [];
const place = c ? `${c.city}, ${st}` : s.sname;

const title = c ? `${c.city}, ${s.sname} Teen Driving Guide` : `${s.sname} Teen Driving Guide`;
const seoTitle = c ? title : `${s.sname} Teen Driving Laws and Permit Requirements`;
const r = s.req;
const short = (v) => String(v || '').split(/[;(]/)[0].trim().replace(/\.$/, '');
const facts = `Permit at ${short(r.permitMinAge)}; license at ${short(r.licenseMinAge)}.`;
const pr = profile;
const hwy = pr ? [...(pr.roads?.interstates || []), ...(pr.roads?.usRoutes || [])].slice(0, 3) : [];
// Meta descriptions stay near 160 characters so search results show them whole:
// the permit and license ages first, then the local detail that makes each city page distinct.
const fit = (parts) => { for (const d of parts) if (d.length <= 160) return d; return parts[parts.length - 1]; };
const cityDesc = () => {
  const tail = `plus ${s.sname} license rules.`;
  const opts = [];
  for (let n = hwy.length; n >= 1; n--) opts.push(`Teen driving in ${c.city}, ${st}: ${facts} Where to practice (${hwy.slice(0, n).join(', ')}), daylight and weather, ${tail}`);
  opts.push(`Teen driving in ${c.city}, ${st}: ${facts} Where to practice, daylight and weather, ${tail}`);
  opts.push(`Teen driving in ${c.city}, ${st}: ${facts} Local practice roads and ${s.sname} rules.`);
  return fit(opts);
};
const description = c
  ? (pr
    ? cityDesc()
    : fit([`How a teen gets a license in ${c.city}, ${st}: ${s.sname} permit age, driver's ed, supervised hours and road test. ${facts}`, `Teen driver's license in ${c.city}, ${st}: ${facts} ${s.sname} permit and road test rules.`]))
  : fit([`${s.sname} teen driver's license, step by step: permit, driver's ed, supervised hours, road test and new-driver limits. ${facts}`, `${s.sname} teen driver's license rules: permit, supervised hours and road test. ${facts}`]);

const crumbs = [
  { name: 'DRVN', item: `${SITE.url}/` },
  { name: 'State Guides', item: `${SITE.url}/guide/` },
  { name: s.sname, item: `${SITE.url}/guide/${s.slug}/` },
  ...(c ? [{ name: c.city, item: `${SITE.url}${c.url}` }] : []),
];
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'HowTo',
      name: `How a teen gets a driver's license in ${place}`,
      step: [r.driversEd, r.permitMinAge && `Learner's permit: minimum age ${r.permitMinAge}`, r.supervisedHours, r.roadTest, r.restrictions]
        .filter(Boolean).map((text, i) => ({ '@type': 'HowToStep', position: i + 1, text })),
    },
    { '@type': 'BreadcrumbList', itemListElement: crumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, ...b })) },
  ],
};
---
<Base title={seoTitle} description={description} jsonld={jsonld}>
  <section class="wrap top">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">DRVN</a><span>/</span><a href="/guide/">State Guides</a>
      {c ? <><span>/</span><a href={`/guide/${s.slug}/`}>{s.sname}</a><span>/</span><span aria-current="page">{c.city}</span></> : <><span>/</span><span aria-current="page">{s.sname}</span></>}
    </nav>
    <h1>{title}</h1>
    <p class="lead">
      {c
        ? <>What parents and teens need to know about getting a driver’s license in {c.city}, {st}: six steps, from the first class to the insurance call.</>
        : <>What parents need to know about the learn-to-drive process in {s.sname}: six steps, from the first class to the insurance call.</>}
    </p>
    <p class="checked">Requirements checked: {CHECKED_LABEL}, against official state licensing sources: <a href={r.agencyUrl} rel="noopener" target="_blank">{r.agency}</a>.</p>
    {!c && otherCities.length > 0 && (
      <div class="findcity">
        <PlaceSearch id="city-search" label={`Find your city’s guide (${otherCities.length} ${s.sname} cities)`} placeholder={`Type your city in ${s.sname}`}
          places={[...otherCities].sort((a, b) => (b.pop || 0) - (a.pop || 0)).map((x) => ({ l: x.city, u: x.url }))}
          notFound={`Not listed? ${s.sname}’s requirements apply statewide, and they’re all below. Try a nearby larger city for local practice roads and conditions.`} />
        <a class="browse" href="#cities-h">or browse all {otherCities.length} city guides ↓</a>
      </div>
    )}
  </section>

  <section class="wrap cols">
    <div class="main">
      {profile && <CityProfile city={c.city} state={s} profile={profile} />}
      {profile && <h2 class="req-h">{s.sname} requirements</h2>}
      <StateSteps state={s} city={c?.city} />

      <section class="bridges" aria-label="Beyond the requirements">
        <div class="bridge rb">
          <h2>Meeting the requirements is only the beginning.</h2>
          <p>Your state determines when your teen is legally eligible to drive. Readiness depends on the experience, judgment, and independence they demonstrate before they drive alone.</p>
          <a class="link-arrow" href="/is-my-teen-ready-to-drive-alone/">See how to evaluate readiness</a>
        </div>
        <div class="bridge ab">
          <h2>Turn the required hours into useful practice.</h2>
          <p>DRVN helps parents plan practice, track driving experience, and see what their teen still needs to work on before driving alone.</p>
          <a class="link-arrow" href="/app/">See how DRVN works</a>
        </div>
      </section>

      {otherCities.length > 0 && (
        <section class="cities" aria-labelledby="cities-h">
          <h2 id="cities-h">{c ? `More ${s.sname} city guides` : `${s.sname} city guides`}</h2>
          <p>Guides for the most popular {s.sname} cities.</p>
          <ul>
            {otherCities.map((x) => <li>{x.slug === c?.slug ? <span aria-current="page">{x.city}</span> : <a href={x.url}>{x.city}</a>}</li>)}
          </ul>
        </section>
      )}

      <section class="other">
        <h2>Guides for other states</h2>
        <StatePicker current={s.slug} />
      </section>
    </div>
    <aside class="side">
      <div class="sticky">
        <AppCard />
        {r.onlineDriversEd && <DriversEdCard state={s.slug} />}
      </div>
    </aside>
  </section>
</Base>

<style>
  .req-h { font-size: 26px; margin: 0 0 14px; }
  .checked { margin: 2px 0 0; font-size: 14.5px; color: var(--muted); }
  .checked a { font-weight: 600; }
  .findcity { display: flex; align-items: flex-end; gap: 10px 24px; flex-wrap: wrap; margin-top: 22px; padding: 20px 22px; background: var(--cyan-tint); border-radius: 14px; }
  .findcity .ps { flex: 1 1 340px; }
  .browse { font-size: 15.5px; font-weight: 700; color: var(--blue); text-decoration: none; padding-bottom: 14px; }
  .browse:hover { text-decoration: underline; }
  #cities-h { scroll-margin-top: 90px; }
  .bridges { margin-top: 36px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .bridge { border-radius: 14px; padding: 22px 24px; display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .bridge h2 { font-size: 20px; margin: 0; line-height: 1.25; }
  .bridge p { margin: 0; font-size: 15.5px; line-height: 1.55; color: var(--ink-3); }
  .rb { background: var(--cyan-tint); }
  .ab { background: var(--surface-2); border: 1px solid var(--line-2); }
  .top { padding-top: 28px; display: flex; flex-direction: column; gap: 10px; }
  .crumbs { display: flex; gap: 8px; align-items: center; font-size: 14px; color: var(--muted); flex-wrap: wrap; }
  .crumbs a { font-weight: 600; text-decoration: none; }
  h1 { font-size: clamp(32px, 4.6vw, 50px); font-weight: 800; letter-spacing: -0.025em; }
  .lead { margin: 0; font-size: 20px; color: var(--ink-3); max-width: 42em; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 48px; margin-top: 28px; }
  .side .sticky { position: sticky; top: 84px; display: flex; flex-direction: column; gap: 16px; }
  .cities, .other { margin-top: 32px; }
  .cities h2, .other h2 { font-size: 24px; margin-bottom: 6px; }
  .cities p { margin: 0 0 12px; color: var(--ink-3); font-size: 16px; }
  .cities ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 18px; }
  .cities li { border-bottom: 1px solid var(--line); }
  .cities a, .cities span { display: block; padding: 6px 0; font-size: 15px; font-weight: 600; text-decoration: none; }
  .cities span { color: var(--muted); }
  @media (max-width: 980px) {
    .cols { grid-template-columns: 1fr; gap: 32px; }
    .bridges { grid-template-columns: 1fr; }
    .side .sticky { position: static; }
    .cities ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) { .cities ul { grid-template-columns: 1fr 1fr; } }
</style>
