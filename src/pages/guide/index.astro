---
import Base from '../../layouts/Base.astro';
import AppCard from '../../components/AppCard.astro';
import states from '../../data/states.json';

// The six steps from the original Teen Driving Guide (/teendrivingroadmap/, now redirected here).
const steps = [
  { t: "Pass the learner's permit exam", d: 'The written test that lets your teen start driving with a licensed adult in the car.' },
  { t: "Enroll in a driver's ed program", d: 'Most states require classroom or online instruction, and some require it before the permit.' },
  { t: 'Practice driving with a parent', d: 'The supervised hours your state requires — and the part of the process that is mostly on you.' },
  { t: 'Practice driving with an instructor', d: 'Behind-the-wheel lessons with a certified instructor, where your state requires them.' },
  { t: "Take the driver's license exam", d: 'The road test, usually after a minimum holding period on the permit.' },
  { t: 'Add your teen to your car insurance', d: 'Plan for it early. Adding a teen driver is one of the bigger jumps in a family budget.' },
];
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How a teen gets a driver’s license',
  step: steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.t, text: s.d })),
};
---
<Base
  title="Teen Driving Guide: state requirements for a teen driver's license"
  description="The six steps to a teen driver's license, and what your state requires at each one — permit age, supervised hours, night and passenger rules."
  jsonld={jsonld}
>
  <section class="wrap top">
    <div class="rule"></div>
    <h1>Teen Driving Guide</h1>
    <p class="lead">From your state's requirements to the practice that actually builds a safe driver. The state sets eligibility. You set readiness.</p>
  </section>

  <section class="wrap cols">
    <div>
      <h2>Six steps to a license</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li><span class="n">{i + 1}</span><div><h3>{s.t}</h3><p>{s.d}</p></div></li>
        ))}
      </ol>

      {states.length > 0 && (
        <>
          <h2 id="states">Choose your state</h2>
          <ul class="states">
            {states.map((s) => <li><a href={`/guide/${s.slug}/`}>{s.name}</a></li>)}
          </ul>
        </>
      )}
    </div>
    <aside><AppCard /></aside>
  </section>
</Base>

<style>
  .top { padding-top: 56px; display: flex; flex-direction: column; gap: 18px; }
  .top .lead { max-width: 40em; }
  h1 { font-size: clamp(36px, 5vw, 56px); font-weight: 800; letter-spacing: -0.025em; }
  .lead { margin: 0; font-size: 21px; color: var(--ink-3); }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 64px; margin-top: 56px; }
  h2 { font-size: 30px; margin-bottom: 24px; }
  h2#states { margin-top: 64px; }
  .steps { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 22px; }
  .steps li { display: flex; gap: 18px; align-items: flex-start; }
  .n { flex: 0 0 40px; height: 40px; border-radius: 50%; background: var(--cyan-tint); color: var(--blue); font-weight: 800; display: grid; place-items: center; }
  .steps h3 { font-size: 20px; margin-bottom: 4px; }
  .steps p { margin: 0; color: var(--ink-3); font-size: 17px; }
  .states { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 6px 20px; }
  .states a { display: block; padding: 8px 0; font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--line); }
  @media (max-width: 980px) { .cols { grid-template-columns: 1fr; } .states { grid-template-columns: 1fr 1fr; } }
</style>
