---
import Base from '../../layouts/Base.astro';
import AppCard from '../../components/AppCard.astro';
import DriversEdCard from '../../components/DriversEdCard.astro';
import { DRIVERS_ED } from '../../site.js';
import PlaceSearch from '../../components/PlaceSearch.astro';
import { states } from '../../lib/guide.js';

// The six steps from the original Teen Driving Guide (/teendrivingroadmap/, now redirected here).
const steps = [
  { t: "Pass the learner's permit exam", d: 'The written test that lets your teen start driving with a licensed adult in the car.' },
  { t: "Enroll in a driver's ed program", d: 'Most states require classroom or online instruction, and some require it before the permit.', link: { href: DRIVERS_ED.default.url, label: "Find an online driver's ed course" } },
  { t: 'Practice driving with a parent', d: 'The supervised hours your state requires — and the part of the process that is mostly on you.' },
  { t: 'Practice driving with an instructor', d: 'Behind-the-wheel lessons with a certified instructor, where your state requires them.' },
  { t: "Take the driver's license exam", d: 'The road test, usually after a minimum holding period on the permit.' },
  { t: 'Add your teen to your car insurance', d: 'Plan for it early. Adding a teen driver is one of the bigger jumps in a family budget.' },
];
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How a teen gets a driver’s license',
  step: steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.t, text: s.d })),
};
---
<Base
  title="Teen Driving Laws by State"
  description="The six steps to a teen driver's license, and what your state requires at each one — permit age, supervised hours, night and passenger rules."
  jsonld={jsonld}
  crumbs={[{ name: 'State guides', path: '/guide/' }]}
>
  <section class="wrap top">
    <div class="rule"></div>
    <h1>Teen Driving Guide</h1>
    <p class="lead">From your state's requirements to the practice that actually builds a safe driver. The state sets eligibility. You set readiness.</p>
    <div class="pick">
      <PlaceSearch id="place-search" label="Find your city or state" placeholder="Type your city or state" src="/places.json"
        notFound="No city guide by that name yet. Choose your state below; its requirements apply statewide." />
      <a class="browse" href="#states">or choose your state from the list ↓</a>
    </div>
    <p class="cmp-link"><a class="link-arrow" href="/teen-driving-laws-by-state/">Compare all 50 states side by side</a></p>
  </section>

  <div class="wrap banner">
    <img src="/images/site/g01-guide-road.jpg" srcset="/images/site/g01-guide-road-800.jpg 800w, /images/site/g01-guide-road.jpg 1600w" sizes="(max-width: 1120px) 100vw, 1072px" alt="A wide, tree-lined road at golden hour, seen from the driver's seat." width="1600" height="842" fetchpriority="high" />
  </div>

  <section class="wrap cols">
    <div>
      <h2>Six steps to a license</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li><span class="n">{i + 1}</span><div><h3>{s.t}</h3><p>{s.d}{s.link && <> <a class="inline-aff" href={s.link.href} rel="sponsored noopener" target="_blank">{s.link.label}</a> <span class="aff-note">(DRVN may earn a referral fee if you enroll through this link.)</span></>}</p></div></li>
        ))}
      </ol>

      {states.length > 0 && (
        <>
          <h2 id="states">Teen driving guides by state</h2>
          <ul class="states">
            {states.map((s) => <li><a href={`/guide/${s.slug}/`}>{s.sname}</a></li>)}
          </ul>
        </>
      )}
    </div>
    <aside class="side"><AppCard /><DriversEdCard /><DriversEdCard variant="driversed" /></aside>
  </section>
</Base>

<style>
  .top { padding-top: 32px; display: flex; flex-direction: column; gap: 12px; }
  .top .lead { max-width: 40em; }
  h1 { font-size: clamp(36px, 5vw, 56px); font-weight: 800; letter-spacing: -0.025em; }
  .pick { margin-top: 6px; display: flex; align-items: flex-end; gap: 10px 24px; flex-wrap: wrap; }
  .pick .ps { flex: 1 1 340px; }
  .browse { font-size: 15.5px; font-weight: 700; color: var(--blue); text-decoration: none; padding-bottom: 14px; }
  .browse:hover { text-decoration: underline; }
  #states { scroll-margin-top: 90px; }
  .lead { margin: 0; font-size: 21px; color: var(--ink-3); }
  .banner { margin-top: 24px; }
  .banner img { width: 100%; aspect-ratio: 3.2 / 1; object-fit: cover; border-radius: 18px; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 48px; margin-top: 32px; }
  h2 { font-size: 28px; margin-bottom: 16px; }
  h2#states { margin-top: 40px; }
  .steps { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px; }
  .steps li { display: flex; gap: 18px; align-items: flex-start; }
  .n { flex: 0 0 40px; height: 40px; border-radius: 50%; background: var(--cyan-tint); color: var(--blue); font-weight: 800; display: grid; place-items: center; }
  .steps h3 { font-size: 20px; margin-bottom: 4px; }
  .steps p { margin: 0; color: var(--ink-3); font-size: 17px; }
  .inline-aff { font-weight: 700; color: var(--blue); white-space: nowrap; }
  .side { display: flex; flex-direction: column; gap: 16px; }
  .states { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 6px 20px; }
  .states a { display: block; padding: 8px 0; font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--line); }
  @media (max-width: 980px) { .cols { grid-template-columns: 1fr; } .states { grid-template-columns: 1fr 1fr; } }
  .aff-note { font-size: 13px; color: var(--muted); }
  .cmp-link { margin: 14px 0 0; }
</style>
