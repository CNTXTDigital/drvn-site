---
import Base from '../../layouts/Base.astro';
import { AREAS, MOST_USEFUL } from '../../lib/learn.js';
import { DRIVERS_ED } from '../../site.js';
import StatePicker from '../../components/StatePicker.astro';
import { allPosts, readingMinutes } from '../../lib/posts.js';

const bySlug = Object.fromEntries(allPosts.map((p) => [p.slug, p]));
const card = (slug) => { const p = bySlug[slug]; if (!p) throw new Error(`Learn: no article /${slug}/`); return { ...p, mins: readingMinutes(p.html) }; };
const areas = AREAS.map((a) => ({ ...a, post: card(a.article), linked: a.links.map(card) }));
const useful = MOST_USEFUL.map(card);
const jsonld = {
  '@type': 'CollectionPage',
  '@id': 'https://www.drvnapp.com/learn/#webpage',
  url: 'https://www.drvnapp.com/learn/',
  isPartOf: { '@id': 'https://www.drvnapp.com/#website' },
  publisher: { '@id': 'https://www.drvnapp.com/#organization' },
  name: 'Learn: the DRVN Guide for parents',
  hasPart: areas.filter((a) => a.post).map((a) => ({ '@type': 'Article', headline: a.post.title, url: `https://www.drvnapp.com/${a.post.slug}/` })),
};
---
<Base
  title="Teen Driving Guidance for Parents"
  description="Straight answers for parents teaching a teen to drive: readiness, what to practice, real risks, the permit year, and the rules and costs."
  image="/images/site/guide-hero.jpg"
  jsonld={jsonld}
  crumbs={[{ name: 'Learn', path: '/learn/' }]}
>
  <section class="top">
    <div class="wrap hero">
      <div class="intro">
        <div class="eyebrow blue">The DRVN Guide</div>
        <h1>Learn what matters before you hand over the keys.</h1>
        <p>Straight answers for parents, grounded in research and nearly ten years of helping families through the learner period. Start with the full guide, or jump to the question on your mind tonight.</p>
      </div>
      <a href="/teen-driving-safety/" class="lead-card">
        <img src="/images/site/guide-hero.jpg" alt="" width="1600" height="842" fetchpriority="high" />
        <div class="lb">
          <div class="eyebrow blue">Start here · The complete guide</div>
          <div class="lt">Teen Driving Safety for Parents: What You Actually Need to Know</div>
          <div class="lx">The complete parent guide to risk, practice, readiness, licensing, and the first months of independent driving.</div>
          <div class="lg">Read the complete guide →</div>
        </div>
      </a>
    </div>
  </section>

  <nav class="wrap chips" aria-labelledby="help-h">
    <h2 id="help-h" class="eyebrow">What do you need help with?</h2>
    <div class="chip-row">{areas.map((a) => <a class="chip" href={`#${a.id}`}>{a.label}</a>)}</div>
  </nav>

  <section class="wrap">
    {areas.map((a) => (
      <div id={a.id} class="area">
        <div class="aq">
          <div class="ah"><span class="num">{a.n}</span><span class="eyebrow blue">{a.label}</span></div>
          <h2>{a.q}</h2>
          <p>{a.blurb}</p>
        </div>
        <div class="pair">
          <a class="feat" href={`/${a.post.slug}/`}>
            <img src={a.post.imageSm || a.img} alt="" width="800" height="421" loading="lazy" />
            <div class="fb">
              <div class="kind blue">Featured · {a.post.mins} min read</div>
              <div class="ft">{a.post.title}</div>
            </div>
          </a>
          <div class="list">
            {a.linked.map((m) => <a class="item" href={`/${m.slug}/`}><span>{m.title}</span><span class="kind">{m.mins} min</span></a>)}
          </div>
        </div>
      </div>
    ))}
  </section>

  <section class="wrap useful" aria-labelledby="useful-h">
    <h2 id="useful-h">Most useful right now</h2>
    <div class="ucards">
      {useful.map((p) => (
        <a class="ucard" href={`/${p.slug}/`}>
          <img src={p.imageSm || p.image} alt="" width="800" height="421" loading="lazy" />
          <div class="ub">
            <div class="kind blue">{AREAS.find((a) => a.id === p.territory)?.label} · {p.mins} min</div>
            <div class="ut">{p.title}</div>
          </div>
        </a>
      ))}
    </div>
    <a class="link-arrow" href="/blog/">View all articles</a>
  </section>

  <section class="wrap act" aria-labelledby="act-h">
    <h2 id="act-h" class="act-h">Know what matters. Then put it into action.</h2>
    <div class="close">
      <div class="col cs">
        <div class="ct">
          <div class="eyebrow">Start with your state</div>
          <div class="ch">Know the rules where you live.</div>
          <div class="cx">Get the current permit age, supervised-driving requirements, night and passenger restrictions, and links to official state sources.</div>
        </div>
        <StatePicker id="state-pick-learn" buttonLabel="Find your state guide →" split />
      </div>
      <div class="col ce">
        <div class="ct">
          <div class="eyebrow">Complete driver’s ed</div>
          <div class="ch">Still need driver’s ed?</div>
          <div class="cx">See what your state requires and find an online driver’s education option available where you live.</div>
        </div>
        <div class="cm"><img class="ace-logo" src="/images/partners/aceable-logo.png" alt="Aceable" width="640" height="140" /><span class="eyebrow">Partner</span></div>
        <div class="cbot">
          <a class="btn btn-sm" href={DRIVERS_ED.default.url} rel="sponsored noopener" target="_blank">Find driver’s ed →</a>
          <div class="cfine">DRVN may earn a referral fee if you enroll through this link.</div>
        </div>
      </div>
      <div class="col ca">
        <div class="ct">
          <div class="eyebrow light">Use DRVN</div>
          <div class="ch">Turn the guidance into practice.</div>
          <div class="cx">DRVN helps you know what to work on, track the experience your teen is building, and see what still needs work before they drive alone.</div>
        </div>
        <div class="cm"><img class="app-icon" src="/images/app/drvn-app-icon.png" alt="DRVN app icon" width="96" height="96" /><span class="cx">Free on iOS and Android</span></div>
        <div class="cbot"><a class="btn btn-sm" href="/app/">See how DRVN works →</a></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .eyebrow.blue, .kind.blue { color: var(--blue); }
  .top { background: linear-gradient(var(--surface-2), var(--surface)); border-bottom: 1px solid var(--line); }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) 480px; gap: 48px; padding-top: 40px; padding-bottom: 40px; align-items: center; }
  .intro { display: flex; flex-direction: column; gap: 14px; }
  h1 { font-size: clamp(36px, 4.6vw, 54px); font-weight: 800; line-height: 1.05; letter-spacing: -0.026em; text-wrap: pretty; }
  .intro p { margin: 0; font-size: 20px; line-height: 1.5; color: var(--ink-2); max-width: 30em; }
  .lead-card { display: flex; flex-direction: column; text-decoration: none; color: inherit; background: var(--surface); border: 1px solid var(--line-2); border-radius: 18px; overflow: hidden; box-shadow: 0 18px 40px -26px rgba(10,108,165,.4); }
  .lead-card:hover { color: inherit; box-shadow: 0 22px 44px -24px rgba(10,108,165,.5); }
  .lead-card img { width: 100%; aspect-ratio: 2.4 / 1; object-fit: cover; }
  .lb { padding: 18px 22px 20px; display: flex; flex-direction: column; gap: 6px; }
  .lt { font-size: 24px; font-weight: 800; color: var(--ink); line-height: 1.2; letter-spacing: -0.015em; }
  .lx { font-size: 15.5px; color: var(--ink-3); line-height: 1.5; }
  .lg { font-weight: 700; color: var(--blue); font-size: 15px; margin-top: 4px; }
  .chips { padding-top: 28px; display: flex; flex-direction: column; gap: 12px; }
  .chips h2 { margin: 0; font-size: 13px; }
  .chip-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .chip { font-size: 14px; font-weight: 600; text-decoration: none; color: var(--ink-2); background: var(--surface); border: 1px solid var(--line-2); border-radius: 999px; padding: 8px 14px; white-space: nowrap; }
  .chip:hover { color: var(--blue); border-color: var(--cyan); }
  .area { display: grid; grid-template-columns: 320px minmax(0, 1fr); gap: 40px; padding: 32px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 80px; }
  .aq { display: flex; flex-direction: column; gap: 8px; }
  .ah { display: flex; align-items: center; gap: 10px; }
  .num { width: 28px; height: 28px; border-radius: 50%; background: var(--cyan-tint); color: var(--blue); font-size: 13px; font-weight: 800; display: grid; place-items: center; }
  .aq h2 { font-size: 27px; font-weight: 800; }
  .aq p { margin: 0; font-size: 16.5px; line-height: 1.55; color: var(--ink-3); }
  .pair { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  .feat { display: flex; gap: 16px; align-items: stretch; text-decoration: none; color: inherit; background: var(--surface); border: 1px solid var(--line-2); border-radius: 14px; overflow: hidden; }
  .feat:hover { box-shadow: 0 18px 40px -26px rgba(10,108,165,.45); color: inherit; }
  .feat { min-height: 168px; }
  .feat img { width: 150px; flex: 0 0 150px; object-fit: cover; align-self: stretch; height: auto; min-height: 100%; }
  .fb { padding: 14px 16px 14px 0; display: flex; flex-direction: column; gap: 4px; justify-content: center; }
  .ft { font-size: 18px; font-weight: 800; line-height: 1.25; color: var(--ink); }
  .item { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; padding: 11px 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink-2); font-weight: 600; font-size: 16px; line-height: 1.4; }
  .item:hover { color: var(--blue); }
  .kind { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted-2); white-space: nowrap; }
  .useful { padding-top: 40px; }
  .useful h2 { font-size: 27px; margin-bottom: 16px; }
  .ucards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-bottom: 16px; }
  .ucard { display: flex; flex-direction: column; text-decoration: none; color: inherit; background: var(--surface); border: 1px solid var(--line-2); border-radius: 14px; overflow: hidden; }
  .ucard:hover { color: inherit; box-shadow: 0 18px 40px -26px rgba(10,108,165,.45); }
  .ucard img { width: 100%; aspect-ratio: 1.9 / 1; object-fit: cover; }
  .ub { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 4px; }
  .ut { font-size: 17px; font-weight: 800; line-height: 1.25; color: var(--ink); }
  .act { padding-top: 48px; }
  .act-h { font-size: clamp(26px, 3vw, 32px); font-weight: 800; letter-spacing: -0.02em; margin: 0; }
  .ct .eyebrow { margin-bottom: 6px; }
  .eyebrow.light { color: var(--cyan-light); }
  .close { margin-top: 20px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: auto auto auto; border: 1px solid var(--line-2); border-radius: 20px; overflow: hidden; }
  .col { grid-row: span 3; display: grid; grid-template-rows: subgrid; row-gap: 18px; padding: 26px 28px; align-items: start; }
  .cs { background: var(--surface-2); }
  .ce { background: var(--surface); border-left: 1px solid var(--line-2); }
  .ca { background: var(--blue); }
  .ch { font-size: 20px; font-weight: 800; color: var(--blue); }
  .cx { font-size: 15.5px; color: var(--ink-3); margin-top: 4px; }
  .ca .ch { color: #fff; }
  .ca .cx { color: #E6F5FC; }
  .cm { display: flex; align-items: center; gap: 12px; min-height: 46px; }
  .cm .cx { margin: 0; }
  .ace-logo { height: 26px; width: auto; display: block; }
  .cm .eyebrow { font-size: 11px; }
  .app-icon { width: 46px; height: 46px; border-radius: 11px; display: block; box-shadow: 0 2px 8px rgba(0,0,0,.18); }
  .cbot { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .cfine { font-size: 12px; color: var(--muted); }
  @media (max-width: 900px) {
    .hero, .area, .pair, .close, .ucards { grid-template-columns: 1fr; }
    .area { gap: 16px; }
    .close { grid-template-rows: none; }
    .col { grid-row: auto; grid-template-rows: none; }
    .ce { border-left: 0; border-top: 1px solid var(--line-2); }
    .chip-row { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 6px; }
  }
  @media (max-width: 520px) { .feat img { width: 110px; flex-basis: 110px; } }
</style>
