---
// Driving school / exam location pages — same URLs as the old site: /listing/{id}/{name-city-st}/
import Base from '../../../layouts/Base.astro';
import AppCard from '../../../components/AppCard.astro';
import DriversEdCard from '../../../components/DriversEdCard.astro';
import PlaceList from '../../../components/PlaceList.astro';
import { listings, stateBySt, cityFor, nearbyListings, formatPhone, mapsUrl, PLACE_TYPES } from '../../../lib/guide.js';
import { SITE, driversEdLink } from '../../../site.js';

export function getStaticPaths() {
  return listings.map((l) => ({ params: { id: String(l.id), path: l.path }, props: { l } }));
}

const { l } = Astro.props;
const s = stateBySt[l.st?.toUpperCase()];
const city = cityFor(l.zcity, l.st?.toUpperCase()) || cityFor(l.city, l.st?.toUpperCase());
const phone = formatPhone(l.phone);
const services = Object.entries(PLACE_TYPES).filter(([k]) => l[k]).map(([, v]) => v.label);
const near = nearbyListings(l);
const FACTS = [
  ['enroll', 'Driver’s ed enrollment'], ['permitPrep', 'Prepare for the permit test'], ['permitExam', 'Permit exam'],
  ['need', 'What you need'], ['dur', 'Practice driving period'], ['parentHrs', 'Supervised hours with a parent'],
  ['instrHrs', 'Hours with an instructor'], ['test', 'Driver’s license test'], ['bring', 'What to bring'],
  ['laws', 'Motor vehicle laws'], ['practice', 'Practice exam'],
];
const facts = FACTS.filter(([k]) => l.facts?.[k]).map(([k, label]) => [label, l.facts[k]]);
const isUrl = (v) => /^https?:\/\//.test(v);

const title = `${l.name} - ${l.city}, ${l.st}`;
const description = `${l.name} in ${l.city}, ${l.st}${services.length ? ` — ${services.join(', ').toLowerCase()}` : ''}. Address, phone, directions, and ${s?.sname || l.st} teen license requirements.`;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': l.osa ? 'GovernmentOffice' : 'DrivingSchool',
      name: l.name,
      url: l.website || undefined,
      telephone: phone?.text,
      address: { '@type': 'PostalAddress', streetAddress: l.addr, addressLocality: l.city, addressRegion: l.st, postalCode: l.zip, addressCountry: 'US' },
      ...(l.lat != null ? { geo: { '@type': 'GeoCoordinates', latitude: l.lat, longitude: l.lon } } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { name: 'Teen Driving Guide', item: `${SITE.url}/guide/` },
        ...(s ? [{ name: s.sname, item: `${SITE.url}/guide/${s.slug}/` }] : []),
        ...(city ? [{ name: city.city, item: `${SITE.url}${city.url}` }] : []),
        { name: l.name, item: `${SITE.url}/listing/${l.id}/${l.path}/` },
      ].map((b, i) => ({ '@type': 'ListItem', position: i + 1, ...b })),
    },
  ],
};
---
<Base title={title} description={description} jsonld={jsonld}>
  <section class="wrap top">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/guide/">Guide</a>
      {s && <><span>/</span><a href={`/guide/${s.slug}/`}>{s.sname}</a></>}
      {city && <><span>/</span><a href={city.url}>{city.city}</a></>}
    </nav>
    <h1>{l.name}</h1>
    {services.length > 0 && <ul class="tags">{services.map((t) => <li>{t}</li>)}</ul>}
  </section>

  <section class="wrap cols">
    <div class="main">
      <div class="card">
        <div class="addr">
          <p class="h">Address</p>
          <p>{l.addr}<br />{l.city}, {l.st} {l.zip}</p>
          {l.county && <p class="muted">{l.county} County</p>}
        </div>
        <div class="acts">
          {phone && <a class="btn btn-sm" href={phone.tel}>Call {phone.text}</a>}
          {l.website && <a class="link-arrow" href={l.website} rel="nofollow noopener" target="_blank">Website</a>}
          <a class="link-arrow" href={mapsUrl(l)} rel="nofollow noopener" target="_blank">Directions</a>
        </div>
      </div>

      {s && (
        <div class="online">
          <div>
            <p class="oh">Prefer to start online?</p>
            <p class="os">Many {s.sname} teens complete the classroom part of driver’s ed online, at their own pace.</p>
          </div>
          <a class="btn btn-sm" href={driversEdLink(s.slug).url} rel="sponsored noopener" target="_blank">Find an online driver’s ed course</a>
        </div>
      )}

      {facts.length > 0 && (
        <section class="facts">
          <h2>{s?.sname || l.st} teen license requirements</h2>
          <dl>
            {facts.map(([k, v]) => <div class="row"><dt>{k}</dt><dd>{isUrl(v) ? <a href={v} rel="nofollow noopener" target="_blank">{v.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a> : v}</dd></div>)}
          </dl>
        </section>
      )}

      {s && (
        <p class="more">
          Every step from permit to license, with {s.sname}’s rules: <a href={`/guide/${s.slug}/`}>{s.sname} Teen Driving Guide</a>
          {city && <> · <a href={city.url}>{city.city} driving schools and exam locations</a></>}
        </p>
      )}

      <PlaceList title={`Other driving schools near ${l.city}`} places={near} />
    </div>
    <aside class="side">
      <div class="sticky">
        <AppCard />
        <DriversEdCard state={s?.slug} />
      </div>
    </aside>
  </section>
</Base>

<style>
  .top { padding-top: 28px; display: flex; flex-direction: column; gap: 10px; }
  .crumbs { display: flex; gap: 8px; align-items: center; font-size: 14px; color: var(--muted); flex-wrap: wrap; }
  .crumbs a { font-weight: 600; text-decoration: none; }
  h1 { font-size: clamp(30px, 4.2vw, 44px); font-weight: 800; letter-spacing: -0.02em; }
  .tags { list-style: none; display: flex; gap: 8px; flex-wrap: wrap; margin: 0; padding: 0; }
  .tags li { font-size: 13px; font-weight: 700; color: var(--blue); background: var(--cyan-tint); padding: 4px 10px; border-radius: 999px; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 48px; margin-top: 24px; }
  .side .sticky { position: sticky; top: 84px; display: flex; flex-direction: column; gap: 16px; }
  .card { border: 1px solid var(--line-2); border-radius: 14px; padding: 18px 20px; display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; align-items: flex-end; }
  .card p { margin: 0; font-size: 17px; line-height: 1.5; }
  .card .h { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted-2); margin-bottom: 4px; }
  .muted { color: var(--muted); font-size: 15px !important; }
  .acts { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
  .online { margin-top: 16px; display: flex; gap: 16px; align-items: center; justify-content: space-between; background: var(--cyan-tint); border-radius: 12px; padding: 14px 16px; }
  .oh { margin: 0; font-weight: 700; color: var(--blue); font-size: 16px; }
  .os { margin: 2px 0 0; font-size: 14px; color: var(--ink-3); }
  .online .btn { flex: none; }
  .facts { margin-top: 28px; }
  .facts h2 { font-size: 22px; margin-bottom: 10px; }
  dl { margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .row { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 12px; font-size: 16px; line-height: 1.5; padding: 6px 0; border-bottom: 1px solid var(--line); }
  dt { font-weight: 600; color: var(--ink-3); font-size: 15px; }
  dd { margin: 0; color: var(--ink-2); overflow-wrap: anywhere; }
  .more { margin: 22px 0 0; font-size: 16px; color: var(--ink-3); }
  @media (max-width: 980px) { .cols { grid-template-columns: 1fr; gap: 32px; } .side .sticky { position: static; } }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; gap: 0; } .online { flex-direction: column; align-items: flex-start; } }
</style>
